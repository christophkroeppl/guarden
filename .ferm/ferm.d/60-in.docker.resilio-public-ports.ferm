domain (ip ip6) {
    table filter chain DOCKER-USER

    # Incoming traffic bound for a docker service will come in
    # to the FORWARD chain on venet0 and exit on docker_edge
    interface venet0 outerface docker_edge

    # Allow Resilio Sync port from the internet to the edge network.
    # 55555: Resilio Sync P2P synchronization port.
    proto tcp dport (55555)

    ACCEPT;
}
