[Unit]
Description=materialise one service's credentials into its own podman secret store
Documentation=file:///usr/share/doc/guarden/
# Runs in the SYSTEM manager, once, as root: the generated unit for a service
# runs in that service's own user manager, which cannot read a 0600 root system
# host key and has no business holding it. So the decryption happens here and the
# generated unit carries no LoadCredentialEncrypted= at all — it only names the
# secret, and podman resolves it.
After=snapperd.service
Requires=snapperd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# No LoadCredentialEncrypted=: a per-service unit cannot name a per-key blob, so the
# materialiser decrypts <KEY>.cred off disk rather than being handed a staged copy.
Environment=GUARDEN_SERVICE=%i
ExecStart=/usr/lib/guarden/bin/weedr secret materialise %i
