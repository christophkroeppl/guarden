{# The route slice `roots` reads from /var/lib/guarden/shared/<service>/routes.toml —
  the slot's file — or, when this render carries an instance, from
  /var/lib/guarden/shared/<service>/instances/<escaped-ref>/routes.toml (spec 2 and 6.4).

  `target` is `<name>:<publication>` — the service's own name, with no suffix
  and no alias (spec 7.3) — and `host` is the name the mutator allocated from
  the manifest's label and the track's root-owned host_prefix, plus the tunnel's
  zone when the route's destination is `tunnel`. A repository only ever gets a
  label, so it cannot name a domain: `host.domain` is in no route's name.
  `destination` is `edge` or `tunnel` — where this route is published.
  `ref` is the instance ref for preview instances, empty for slot tracks.
  `basicauth` is the LOGIN MINTED for this service at creation (spec 3.4), a
  fact about the past. Whether the edge attaches the middleware that asks for it
  is the operator's setting in the service's root-owned `overrides.toml` (§3.3,
  ADR-0024), which `roots` reads beside this flag; the slice does not carry it.
#}
# Rendered by loom. The mutator installs this read-only; `roots` reads it.
service = "{{ service }}"
project = "{{ project }}"
track = "{{ track }}"
basicauth = {{ "true" if basicauth else "false" }}
{% for route in rows %}
[[routes]]
container = "{{ route.container }}"
port = {{ route.port }}
publication = {{ route.publication }}
host = "{{ route.host }}"
label = "{{ route.label }}"
auth = {{ "true" if route.auth else "false" }}
target = "{{ route.target }}"
destination = "{{ route.destination }}"
ref = "{{ route.ref }}"
{% endfor %}
