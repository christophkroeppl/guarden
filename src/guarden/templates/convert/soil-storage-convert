#!/usr/bin/env bash
# soil-storage-convert — offline ext4 → btrfs conversion + @/@var/@tmp migration.
#
# **This is the phase's machinery, shipped with the programs.** It lives under
# `/usr/lib/guarden/templates/convert/` — installed by `soil install` from
# `src/guarden/templates/convert/` — and `soil storage` is what runs it:
# `hostprep.storage_items`' btrfs-layout item and root-conversion-marker item
# invoke `--apply` and translate its exit codes into the phase's own
# reporting. `75` means "a reboot is required", which is a state of the host
# and not a failure; everything else is the script's own stderr, reported.
#
# It is a staged state machine because the conversion crosses reboots and the
# state file is the only thing that survives them: the dispatch at the bottom
# selects a stage, and the rest of the file is invoking system tools in a
# sequence, which is what bash is here for.
#
# The guarden port of .install/30-convert-btrfs.sh from the retired `next` branch.
# Two things differ from that script and both are forced by the spec:
#
#   * the subvolumes are `@`, `@var` and `@tmp`, not `@` and `@home` — spec 6.1
#     and src/guarden/hostprep.py `_btrfs_layout_holds()`, which reads
#     `btrfs subvolume list /` and requires exactly those three names;
#   * the state directory is `/var/lib/guarden/soil/` (spec 6.1's filesystem
#     table: "soil/ — the btrfs convert state and the reboot marker", 0750
#     root:guarden), not a private /var/lib tree of its own.
#
# /home is NOT split off: it stays a directory inside `@`, and snapper
# snapshots a subvolume, so a configuration for it could not be created on
# that layout at all -- the host's configurations are `root` alone
# (hostprep.HOST_CONFIGURATIONS), and `_btrfs_layout_holds()` is written to
# accept exactly that layout.
#
# `@tmp` is the third subvolume and it is the one with **no snapper
# configuration and no ladder**, which is the operator's requirement
# (ticket 340): `/tmp` is volatile data and not to be snapshotted. The
# subvolume is created at the btrfs **top level** — a `@tmp` nested inside `@`
# would be the fail-open shape, because `subvol=@tmp` resolves against the
# filesystem's top level and the mount would then fall back to the tmpfs
# while the layout looked right to anyone who only grepped for the name. The
# distribution's `q /tmp 1777 root root 10d` applies the mode to the mounted
# subvolume at boot, so the script does not chmod it.
#
# Usage: soil-storage-convert [--check|--apply] [--yes]
set -euo pipefail

# --- layout, per spec 6.1 and hostprep.py ------------------------------------
STATE_DIR="/var/lib/guarden/soil"
STATE_FILE="${STATE_DIR}/state"
ROOT_MOUNT="/"
ROOT_SUBVOL="@"
VAR_MOUNT="/var"
VAR_SUBVOL="@var"
TMP_MOUNT="/tmp"
TMP_SUBVOL="@tmp"
MOUNT_OPTS="subvol=%s,noatime,compress=zstd"
# /tmp keeps the two security options the tmpfs it replaces carried. Dropping
# them silently would put a world-writable directory on a filesystem that
# honours suid and device nodes.
TMP_MOUNT_OPTS="subvol=%s,noatime,compress=zstd,nosuid,nodev"
FSTAB_TAG="guarden-storage"
REBOOT_MARKER="${STATE_DIR}/reboot-required"
ASSUME_YES=0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DRACUT_MODULE_SRC="${SCRIPT_DIR}/dracut/99guarden-convert"
DRACUT_MODULE_DST="/usr/lib/dracut/modules.d/99guarden-convert"
# /var goes into @var, /tmp into @tmp, /home stays a plain directory inside @.
RSYNC_EXCLUDES=(
  --exclude=/proc/ --exclude=/sys/ --exclude=/dev/ --exclude=/run/
  --exclude=/tmp/ --exclude=/mnt/ --exclude=/media/
  --exclude=/var/ --exclude=/lost+found/
  --exclude=/ext2_saved/ --exclude=/ext3_saved/ --exclude=/ext4_saved/
  '--exclude=/btrfs_convert_backup*'
)

usage() {
  printf 'usage: soil-storage-convert [--check|--apply] [--yes]\n'
  printf '  --check  read-only; exit 0 only when / is btrfs on @, /var on @var and /tmp on @tmp\n'
  printf '  --apply  converge one step; exit 75 when a reboot is required (re-run after)\n'
  printf '  --yes    skip the destructive-conversion confirmation\n'
}

log() { printf '[soil-storage] %s\n' "$*"; }
err() { printf '[soil-storage] %s\n' "$*" >&2; }

MODE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help) usage; exit 0 ;;
  --check | --apply) MODE="$1" ;;
  --yes | -y) ASSUME_YES=1 ;;
  *) usage >&2; exit 2 ;;
  esac
  shift
done
[[ -n "$MODE" ]] || { usage >&2; exit 2; }

# --- filesystem helpers ------------------------------------------------------
root_fstype() { findmnt -n -o FSTYPE --target / 2>/dev/null || stat -f -c %T /; }
root_device() {
  local d
  d="$(findmnt -n -o SOURCE --target / 2>/dev/null || true)"
  printf '%s' "${d%%[*}"
}
root_uuid() { findmnt -n -o UUID --target / 2>/dev/null || true; }
mount_opts() { findmnt -n -o OPTIONS --target "$1" 2>/dev/null || true; }
is_mountpoint() { findmnt -n --mountpoint "$1" >/dev/null 2>&1; }
opt_has_subvol() { [[ ",$1," == *",subvol=/$2,"* || ",$1," == *",subvol=$2,"* ]]; }
root_disk() {
  lsblk -sno NAME,TYPE "$(root_device)" 2>/dev/null | awk '$2=="disk"{print "/dev/"$1; exit}'
}

require_root() {
  [[ "${EUID:-$(id -u)}" -eq 0 ]] || { err "needs root"; exit 1; }
}

state_get() { [[ -r "$STATE_FILE" ]] && cat "$STATE_FILE" 2>/dev/null || printf 'none'; }
state_set() {
  mkdir -p "$STATE_DIR"
  chown root:guarden "$STATE_DIR" 2>/dev/null || true
  chmod 0750 "$STATE_DIR" 2>/dev/null || true
  printf '%s\n' "$1" >"$STATE_FILE"
}

# The reboot marker is what spec/sysadmin.md means by "reports the reboot marker
# and names it": --check prints the path whenever the marker is present.
reboot_marker_set() { mkdir -p "$STATE_DIR"; : >"$REBOOT_MARKER"; }
reboot_marker_clear() { rm -f "$REBOOT_MARKER"; }
reboot_marker() { [[ -e "$REBOOT_MARKER" ]] && printf '%s' "$REBOOT_MARKER" || printf ''; }

# `quiet` keeps a predicate from printing a diagnosis: base_layout_holds() is
# asked twice on a host whose layout is wrong, and the diagnosis belongs to the
# check that already gave it, not to the question of which stage to run.
check_mount() { # <mount> <subvol> [quiet]
  local opts
  is_mountpoint "$1" || {
    [[ "${3:-}" == quiet ]] || err "$1: not a separate mountpoint (want subvol $2)"
    return 1
  }
  opts="$(mount_opts "$1")"
  if opt_has_subvol "$opts" "$2"; then
    [[ "${3:-}" == quiet ]] || log "$1: btrfs subvol $2"
    return 0
  fi
  [[ "${3:-}" == quiet ]] || err "$1: mounted but not subvol $2 (got '${opts}')"
  return 1
}

# This is the same predicate hostprep._btrfs_layout_holds() applies:
#   h.run("btrfs", "subvolume", "list", "/")  then
#   "@" in layout and "@var" in layout and "@tmp" in layout
verify_layout() {
  local rc=0
  [[ "$(root_fstype)" == btrfs ]] || { err "root filesystem is '$(root_fstype)', not btrfs"; return 1; }
  check_mount "$ROOT_MOUNT" "$ROOT_SUBVOL" || rc=1
  check_mount "$VAR_MOUNT" "$VAR_SUBVOL" || rc=1
  check_mount "$TMP_MOUNT" "$TMP_SUBVOL" || rc=1
  return "$rc"
}

# The two-subvolume layout a host converted before `@tmp` existed carries. A
# host with these two and not the third is a host to *finish*, not one to
# convert again: re-running stage 2 on it would rsync `/` into `@` a second
# time, and the running system is already `@`.
base_layout_holds() {
  local rc=0
  [[ "$(root_fstype)" == btrfs ]] || return 1
  check_mount "$ROOT_MOUNT" "$ROOT_SUBVOL" quiet || rc=1
  check_mount "$VAR_MOUNT" "$VAR_SUBVOL" quiet || rc=1
  return "$rc"
}

# --- stage 1: schedule the offline conversion --------------------------------
space_check() {
  local used="" avail=""
  read -r used avail < <(df -Pk / | awk 'NR==2 {print $3, $4}') || true
  [[ "$avail" =~ ^[0-9]+$ ]] || { err "cannot parse df for /"; return 0; }
  ((avail >= 1048576)) || {
    err "not enough free space for btrfs-convert: ${avail}KB free (<1GB)"
    return 1
  }
  ((used == 0 || avail * 10 >= used)) ||
    err "low free space (${avail}KB free vs ${used}KB used); conversion may fail"
  log "free space: ${avail}KB"
}

confirm_conversion() {
  local dev="$1" answer=""
  ((ASSUME_YES == 1)) && return 0
  [[ -t 0 ]] || { err "refusing destructive conversion without --yes (non-interactive)"; return 1; }
  err "the next boot converts ${dev} ($(root_fstype)) to btrfs OFFLINE in the initramfs,"
  err "then reboots again to migrate into @/@var/@tmp; the ext4 backup is kept until verified."
  read -r -p "[soil-storage] type 'convert' to continue: " answer || true
  [[ "$answer" == "convert" ]]
}

install_convert_hook() {
  local f
  command -v dracut >/dev/null 2>&1 || {
    err "automated conversion needs dracut; other initramfs generators convert"
    err "offline from a rescue environment instead"
    return 1
  }
  if ! command -v btrfs-convert >/dev/null 2>&1; then
    log "installing btrfs-progs..."
    apt-get update && apt-get install -y btrfs-progs
  fi
  command -v btrfs-convert >/dev/null 2>&1 || { err "btrfs-convert missing"; return 1; }
  log "installing dracut module to ${DRACUT_MODULE_DST}..."
  install -d -m 0755 "$DRACUT_MODULE_DST"
  for f in module-setup.sh guarden-convert-hook.sh; do
    install -m 0755 "${DRACUT_MODULE_SRC}/${f}" "${DRACUT_MODULE_DST}/${f}"
  done
  log "rebuilding the initramfs with dracut (embeds the one-shot conversion hook)..."
  # dracut only: update-initramfs succeeds without embedding the module, and the
  # conversion then silently never happens.
  dracut -f || { err "could not rebuild the initramfs with dracut"; return 1; }
  log "offline conversion scheduled: the hook runs before root mount on next boot"
}

remove_convert_hook() {
  [[ -d "$DRACUT_MODULE_DST" ]] || return 0
  log "removing the dracut conversion module..."
  rm -rf "$DRACUT_MODULE_DST"
  local out
  if command -v dracut >/dev/null 2>&1; then
    out="$(dracut -f 2>&1)" || err "could not rebuild the initramfs: ${out//$'\n'/; }"
  fi
}

schedule_conversion() {
  local dev="$1"
  space_check || return 1
  confirm_conversion "$dev" || return 1
  # State must say "converting" BEFORE the initramfs is rebuilt: the dracut
  # module bakes the enable marker only while the state file says converting.
  state_set converting
  install_convert_hook || return 1
  reboot_marker_set
  log "conversion scheduled; a reboot is required (the initramfs hook converts offline)"
  exit 75
}

# --- stage 2: migrate flat btrfs → @/@var -----------------------------------
TOP="" CHROOT=""
cleanup_mounts() {
  if [[ -n "$CHROOT" ]]; then
    unmount_binds "$CHROOT"
    umount "$CHROOT" 2>/dev/null || true
    rmdir "$CHROOT" 2>/dev/null || true
    CHROOT=""
  fi
  if [[ -n "$TOP" ]]; then
    umount "$TOP" 2>/dev/null || true
    rmdir "$TOP" 2>/dev/null || true
    TOP=""
  fi
}
trap cleanup_mounts EXIT

unmount_binds() {
  local rootfs="$1" d
  for d in run proc sys dev boot/efi boot; do umount "${rootfs}/${d}" 2>/dev/null || true; done
}

try_mount() {
  local what="$1" dir="$2" out
  shift 2
  if out="$(mount "$@" "$dir" 2>&1)"; then return 0; fi
  err "cannot mount ${what}: ${out//$'\n'/; }"
  return 1
}

migrate_subvolumes() {
  local dev uuid disk name d fstab_new
  dev="$(root_device)"
  [[ -n "$dev" ]] || { err "cannot determine root device"; return 1; }

  TOP="$(mktemp -d /tmp/guarden-btrfs-top.XXXXXX)"
  log "mounting btrfs top-level at ${TOP}..."
  try_mount "${dev} top-level" "$TOP" -o subvolid=5 "$dev" || return 1

  for name in "$ROOT_SUBVOL" "$VAR_SUBVOL" "$TMP_SUBVOL"; do
    if btrfs subvolume show "${TOP}/${name}" >/dev/null 2>&1; then
      log "subvol ${name} already present"
    elif [[ -e "${TOP}/${name}" ]]; then
      err "${TOP}/${name} exists but is not a subvolume; move it aside manually"
      return 1
    else
      log "creating subvol ${name}..."
      btrfs subvolume create "${TOP}/${name}" || return 1
    fi
  done

  log "copying / into @ (virtual dirs, /var and /tmp excluded)..."
  rsync -aAXHS --delete --numeric-ids --one-file-system "${RSYNC_EXCLUDES[@]}" \
    / "${TOP}/${ROOT_SUBVOL}/" || { err "rsync / → @ failed"; return 1; }
  log "copying /var into @var..."
  rsync -aAXHS --delete --numeric-ids --one-file-system --exclude=/lost+found/ \
    /var/ "${TOP}/${VAR_SUBVOL}/" || { err "rsync /var → @var failed"; return 1; }

  # The excludes never create these on the receiver; /var and /tmp are now
  # mountpoints.
  for d in dev proc sys run tmp mnt media var; do mkdir -p "${TOP}/${ROOT_SUBVOL}/${d}"; done

  uuid="$(root_uuid)"
  [[ -n "$uuid" ]] || uuid="$dev"
  log "rewriting fstab in @ (keeping /boot and /boot/efi entries)..."
  fstab_new="${TOP}/${ROOT_SUBVOL}/etc/fstab"
  # The /tmp line is dropped whatever it says: `systemd-fstab-generator` keeps
  # the FIRST entry for a path and refuses the second, so a leftover tmpfs line
  # would win and @tmp would never mount — the same fail-open shape as a
  # nested @tmp.
  awk '/^[[:space:]]*#/ {print; next} $2=="/" || $2=="/var" || $2=="/tmp" {next} {print}' \
    "$fstab_new" >"${fstab_new}.new"
  {
    printf 'UUID=%s / btrfs %s 0 0 # %s\n' "$uuid" "$(printf "$MOUNT_OPTS" "$ROOT_SUBVOL")" "$FSTAB_TAG"
    printf 'UUID=%s /var btrfs %s 0 0 # %s\n' "$uuid" "$(printf "$MOUNT_OPTS" "$VAR_SUBVOL")" "$FSTAB_TAG"
    printf 'UUID=%s /tmp btrfs %s 0 0 # %s\n' "$uuid" "$(printf "$TMP_MOUNT_OPTS" "$TMP_SUBVOL")" "$FSTAB_TAG"
  } >>"${fstab_new}.new"
  mv "${fstab_new}.new" "$fstab_new"

  log "regenerating GRUB from @..."
  # chroot into a real mount of @ (not a directory of the top-level mount):
  # grub-probe resolves the device for / through the mount table.
  CHROOT="$(mktemp -d /tmp/guarden-btrfs-chroot.XXXXXX)"
  try_mount "subvol ${ROOT_SUBVOL} at ${CHROOT}" "$CHROOT" -o "$(printf "$MOUNT_OPTS" "$ROOT_SUBVOL")" "$dev" ||
    return 1
  for d in dev sys proc run; do try_mount "/${d} → ${CHROOT}/${d}" "${CHROOT}/${d}" --bind "/${d}" || true; done
  is_mountpoint /boot && { try_mount "/boot → ${CHROOT}/boot" "${CHROOT}/boot" --bind /boot || true; }
  is_mountpoint /boot/efi && { try_mount "/boot/efi → ${CHROOT}/boot/efi" "${CHROOT}/boot/efi" --bind /boot/efi || true; }

  local rc=0
  chroot "$CHROOT" update-grub || rc=1
  # Reinstall only when /boot lives on the converted root: a BIOS core.img embeds
  # an ext4 driver and must be rebuilt to read btrfs; a separate /boot partition
  # is untouched and keeps working.
  if ((rc == 0)) && ! is_mountpoint /boot; then
    disk="$(root_disk)"
    if [[ -z "$disk" ]]; then
      err "cannot determine whole disk for grub-install"
      rc=1
    elif [[ -d /sys/firmware/efi ]]; then
      log "grub-install --efi-directory=/boot/efi..."
      chroot "$CHROOT" grub-install --efi-directory=/boot/efi || rc=1
    else
      log "grub-install ${disk}..."
      chroot "$CHROOT" grub-install "$disk" || rc=1
    fi
  fi
  ((rc == 0)) || { err "GRUB regeneration failed inside @"; return 1; }

  # The running system is still the top-level subvolume, so after reboot the
  # script reads @var's copy of /var/lib/guarden/soil: seed the state there too.
  mkdir -p "${TOP}/${VAR_SUBVOL}/lib/guarden/soil"
  printf 'migrated\n' >"${TOP}/${VAR_SUBVOL}/lib/guarden/soil/state"
  : >"${TOP}/${VAR_SUBVOL}/lib/guarden/soil/reboot-required"
  state_set migrated
  reboot_marker_set
  log "migration staged; a reboot is required to boot from subvol ${ROOT_SUBVOL}"
  exit 75
}

# --- stage 4: the @tmp a host converted before it existed --------------------
# The conversion above creates @tmp; a host converted before this change exists
# has @ and @var and no third subvolume, and the layout predicate now requires
# one. Finishing that host is one subvolume and one fstab line -- not another
# rsync of /, which is what stage 2 would do and which would copy the running
# system onto itself. The reboot is the mechanism rather than a live mount over
# a busy /tmp: /tmp holds live files on a running host, and mounting the new
# subvolume over it would orphan them under processes that are not going away.
migrate_tmp_subvolume() {
  local dev uuid fstab_new
  dev="$(root_device)"
  [[ -n "$dev" ]] || { err "cannot determine root device"; return 1; }

  TOP="$(mktemp -d /tmp/guarden-btrfs-top.XXXXXX)"
  log "mounting btrfs top-level at ${TOP}..."
  try_mount "${dev} top-level" "$TOP" -o subvolid=5 "$dev" || return 1

  if btrfs subvolume show "${TOP}/${TMP_SUBVOL}" >/dev/null 2>&1; then
    log "subvol ${TMP_SUBVOL} already present"
  else
    log "creating subvol ${TMP_SUBVOL} at the top level..."
    btrfs subvolume create "${TOP}/${TMP_SUBVOL}" || return 1
  fi

  # The fstab here is the live one -- the root is @ already, so /etc/fstab is
  # the file inside @ that the original conversion wrote -- and only the /tmp
  # line is touched: the / and /var lines are already the guarden ones, and
  # rewriting them would discard whatever the operator has since changed.
  uuid="$(root_uuid)"
  [[ -n "$uuid" ]] || uuid="$dev"
  fstab_new="/etc/fstab"
  awk '/^[[:space:]]*#/ {print; next} $2=="/tmp" {next} {print}' \
    "$fstab_new" >"${fstab_new}.new"
  printf 'UUID=%s %s btrfs %s 0 0 # %s\n' "$uuid" "$TMP_MOUNT" \
    "$(printf "$TMP_MOUNT_OPTS" "$TMP_SUBVOL")" "$FSTAB_TAG" \
    >>"${fstab_new}.new"
  mv "${fstab_new}.new" "$fstab_new"

  reboot_marker_set
  log "subvol ${TMP_SUBVOL} and its fstab line are staged; a reboot is required to mount ${TMP_MOUNT} on it"
  exit 75
}

# --- stage 3: verify + drop the conversion backup ----------------------------
cleanup_backup() {
  local dev top name out
  dev="$(root_device)"
  top="$(mktemp -d /tmp/guarden-btrfs-top.XXXXXX)"
  if out="$(mount -o subvolid=5 "$dev" "$top" 2>&1)"; then
    for name in ext2_saved ext3_saved ext4_saved; do
      if btrfs subvolume show "${top}/${name}" >/dev/null 2>&1; then
        log "deleting conversion backup subvol ${name}..."
        btrfs subvolume delete "${top}/${name}" || err "could not delete ${name}"
      fi
    done
    rm -f "${top}"/btrfs_convert_backup* 2>/dev/null || true
    umount "$top" || err "could not unmount ${top}"
  else
    err "could not mount top-level to drop the conversion backup: ${out//$'\n'/; }"
  fi
  rmdir "$top" 2>/dev/null || true
}

# --- dispatch ----------------------------------------------------------------
require_root
state="$(state_get)"
log "state: ${state}; root: $(root_fstype) on $(root_device)"

if [[ "$MODE" == --check ]]; then
  marker="$(reboot_marker)"
  [[ -n "$marker" ]] && log "reboot marker present: ${marker}"
  if verify_layout && [[ "$state" == done ]]; then
    log "btrfs @/@var/@tmp layout is in place"
    exit 0
  fi
  log "conversion needed: this script --apply [--yes]"
  exit 1
fi

case "$state" in
done)
  if verify_layout; then
    # A crash in the window between `state_set done` and `reboot_marker_clear`
    # in stage 3 leaves state=done with the marker still present — a state
    # nothing before this cleared: every later `--apply` said done, the marker
    # stayed, and the phase reported a reboot nobody needed. Clearing it here
    # makes that window self-healing.
    reboot_marker_clear
    exit 0
  fi
  # A host converted before `@tmp` existed: @ and @var are in place and the
  # third is missing. Finish it rather than converting it again.
  if base_layout_holds; then
    migrate_tmp_subvolume || exit 1 # exits 75 on success
  fi
  err "state=done but the layout does not verify; manual inspection needed"
  exit 1
  ;;
migrated)
  verify_layout || { err "state=migrated but layout does not verify; reboot and re-run"; exit 1; }
  cleanup_backup
  remove_convert_hook
  state_set done
  reboot_marker_clear
  log "btrfs conversion complete (backup removed, initramfs hook removed)"
  exit 0
  ;;
converting | none)
  case "$(root_fstype)" in
  btrfs)
    if verify_layout; then
      cleanup_backup
      state_set done
      reboot_marker_clear
      log "btrfs @/@var/@tmp layout already present"
      exit 0
    fi
    # @ and @var in place and @tmp missing: finish, do not re-convert.
    if base_layout_holds; then
      migrate_tmp_subvolume || exit 1 # exits 75 on success
    fi
    state_set converting
    migrate_subvolumes || exit 1 # exits 75 on success
    ;;
  ext4) schedule_conversion "$(root_device)" || exit 1 ;; # exits 75 on success
  *)
    err "unsupported root filesystem '$(root_fstype)' (want ext4 or btrfs)"
    exit 1
    ;;
  esac
  ;;
*)
  err "unknown state '${state}' in ${STATE_FILE}"
  exit 1
  ;;
esac
