# Jellyfin media server from a guarden service template:
# `weedr service create <name> --template jellyfin` copies this file into the
# service's own quadlet directory, `0640` under the service uid.
#
# **A template declares nothing guarden reads** (spec 4): no `state:` and no
# `bulk:`, no `ports:`, no `schema:`. So guarden creates no subvolume and no
# snapper configuration, allocates no publication and writes no firewall rule
# — the `PublishPort=` below binds loopback only and is reachable from this
# box until a manifest declares a route and an admin grants it. The config and
# media volumes arrive as named podman volumes in the service's own store; the
# guarden state volumes (config, media) arrive with the first manifest that
# comes in through `weedr service add`.
#
# The image is pinned to a dated tag, deliberately: a `:latest` that updates
# itself is not pinned, and neither `jellyfin/jellyfin` nor
# `linuxserver/jellyfin` is a default. Software transcoding only to begin
# with: no `/dev/dri`, no GPU. The hardware upgrade is a root-owned drop-in
# at /etc/containers/systemd/users/<uid>/jellyfin.container.d/10-devdri.conf
# containing the device, added by hand, surviving redeploys because nothing
# reads or rewrites it.
#
# `JELLYFIN_PublishedServerUrl`, `PUID`, `PGID` and `TZ` are non-secret values:
# set them in the service's `.guarden/.env.schema` / unit as needed. The
# widget's API key is generated by the operator after first start and lives in
# the widget file.

[Unit]
Description=jellyfin from a guarden service template

[Container]
Image=docker.io/jellyfin/jellyfin:2026102610
# Jellyfin's own web port inside the container, on loopback only. Nothing
# forwards it until a manifest declares a route and an admin grants it.
PublishPort=127.0.0.1:8096:8096
# The vendor's config directory: the library database, users, watched metadata.
Volume=config:/config
# The media library. Large, and still precious: declared `state` in the
# manifest, with its own snapper configuration.
Volume=media:/media
# Non-secret values (optional). Software transcoding only to begin with.
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=UTC