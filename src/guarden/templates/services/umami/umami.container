# Umami web analytics from a guarden service template:
# `weedr service create <name> --template umami` copies this file into the
# service's own quadlet directory, `0640` under the service uid, exactly where
# a rendered unit lands.
#
# Nothing in this file is rendered. A template carries no manifest, so guarden
# resolves no volume name, allocates no publication and writes no credential
# line — what the file says is what runs. Read `examples/README.md` for what
# that costs and how a manifest brings it back.
#
# Umami reads only `DATABASE_URL` and understands neither `DB_HOST` nor
# `DB_PORT`, so the database edge's rendered credentials are not enough on
# their own: the operator composes
#
#   postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_DATABASE>
#
# from the edge (DB_HOST/DB_PORT/DB_USER/DB_DATABASE as environment, the
# password as the DB_PASSWORD podman secret) and plants it before the first
# start:
#
#   weedr secret set <name> DATABASE_URL
#
# The unit references it as a type=env secret; the value has to be in the
# service's own podman store before the container is created.
#
# A template declares no `state:`, no `bulk:`, no `ports:` and no `provides:`:
# umami keeps nothing of its own (analytics data lives in the database it
# edges to), allocates no publication until a manifest asks for one, and
# provides no consumer-facing kind — other services reach umami on its
# publication once the operator grants one (`weedr port open`).

[Unit]
Description=umami from a guarden service template

[Container]
Image=ghcr.io/umami-software/umami:postgresql-latest
# Loopback only. No port of a template-created service is granted a DNAT, so
# until a manifest and `weedr port open` say otherwise the only way to this
# publication is from this box.
PublishPort=127.0.0.1:3000:3000
# Planted by the operator before the first start (see above):
#   weedr secret set <name> DATABASE_URL
Secret=DATABASE_URL,type=env
