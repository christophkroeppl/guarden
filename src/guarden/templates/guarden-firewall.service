[Unit]
Description=guarden firewall (ferm)
Documentation=file:///usr/share/doc/guarden/
After=network-pre.target
Wants=network-pre.target
Before=sshd.service
ConditionPathExists=/etc/guarden/firewall/10-framework.conf

[Service]
Type=oneshot
RemainAfterExit=yes
# All root-owned .conf files in /etc/guarden/firewall/ are loaded in lexical
# order, so 00-ssh.conf is first by construction. The files are
# 00-ssh.conf (root, seed-once, the SSH accept), 10-framework.conf (soil),
# 20-ingress-nat.conf (soil), 30-admin.conf (admin/module drop-in) and
# 50-services.conf (the mutator).
#
# Non-root-owned files are skipped, matching the Python validator in
# firewall.py:installed() -- a service user must not be able to add a rule by
# writing a .conf file into a root-owned directory. The directory is 0755 root
# so only root can create a file here, but the check is defence in depth: the
# validator and the shell that feeds ferm must agree, or a file the validator
# warned about still reaches the firewall.
ExecStart=/bin/sh -c 'find /etc/guarden/firewall/ -maxdepth 1 -name "*.conf" -user 0 | sort | xargs cat 2>/dev/null > /etc/guarden/firewall/.combined.conf; exec /usr/sbin/ferm /etc/guarden/firewall/.combined.conf'
ExecReload=/bin/sh -c 'find /etc/guarden/firewall/ -maxdepth 1 -name "*.conf" -user 0 | sort | xargs cat 2>/dev/null > /etc/guarden/firewall/.combined.conf; exec /usr/sbin/ferm /etc/guarden/firewall/.combined.conf'
ExecStop=/bin/sh -c 'find /etc/guarden/firewall/ -maxdepth 1 -name "*.conf" -user 0 | sort | xargs cat 2>/dev/null > /etc/guarden/firewall/.combined.conf; exec /usr/sbin/ferm -F /etc/guarden/firewall/.combined.conf'

[Install]
WantedBy=multi-user.target