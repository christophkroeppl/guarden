[Unit]
Description=guarden firewall (ferm)
Documentation=file:///usr/share/doc/guarden/
After=network-pre.target
Wants=network-pre.target
Before=sshd.service
# The distribution's own firewall is disabled by soil firewall, not merely
# bypassed: two policies on one box is one too many, and the dead-man timer's
# effect is to put the distribution's back.
Conflicts=ufw.service
ConditionPathExists=/etc/guarden/firewall/10-framework.conf

[Service]
Type=oneshot
RemainAfterExit=yes
# The three files are disjoint and each has exactly one writer: 10 and 20 are
# soil's, 30 is the mutator's. They are read in order and flushed once.
# ferm takes ONE input file and has no `-f`, so the three are assembled here; a
# missing file is skipped, because 30-services.conf is absent until a service exists.
ExecStart=/bin/sh -c 'cat /etc/guarden/firewall/10-framework.conf /etc/guarden/firewall/20-ingress-nat.conf /etc/guarden/firewall/30-services.conf 2>/dev/null > /etc/guarden/firewall/.combined.conf; exec /usr/sbin/ferm /etc/guarden/firewall/.combined.conf'
ExecReload=/bin/sh -c 'cat /etc/guarden/firewall/10-framework.conf /etc/guarden/firewall/20-ingress-nat.conf /etc/guarden/firewall/30-services.conf 2>/dev/null > /etc/guarden/firewall/.combined.conf; exec /usr/sbin/ferm /etc/guarden/firewall/.combined.conf'
ExecStop=/bin/sh -c 'cat /etc/guarden/firewall/10-framework.conf /etc/guarden/firewall/20-ingress-nat.conf /etc/guarden/firewall/30-services.conf 2>/dev/null > /etc/guarden/firewall/.combined.conf; exec /usr/sbin/ferm -F /etc/guarden/firewall/.combined.conf'

[Install]
WantedBy=multi-user.target
