{#
  The per-project links, generated by `twig` from `projects.toml` (spec 6.5).

  One entry per project with a card on the dashboard: its repository, and the
  route host the mutator allocated for each of its services. The host is
  `<track host_prefix><label>` and it came from the registry, so a link cannot
  name a host the edge does not answer on.
#}
# Generated by twig from /etc/guarden/projects.toml and the service registries.
{% for row in rows %}
{{ row.project }}:
  href: {{ row.repository }}
  groups:
{% for group in row.groups %}
    - {{ group.hosts | join(", ") }}
{% endfor %}
{% endfor %}
