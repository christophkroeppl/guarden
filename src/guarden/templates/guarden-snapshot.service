[Unit]
Description=a routine snapshot of every service's state volumes
Documentation=file:///usr/share/doc/guarden/
# A routine snapshot is what the nightly timer makes: `timeline`-tagged, and it
# lives by the volume's ladder rather than by a pin. It is taken while the
# service keeps running, and it is never marked — a mark is only ever about an
# on-demand snapshot.
Requires=snapperd.service
After=snapperd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/guarden/bin/weedr service snapshot --all
# Then the reconciler, under the same lock the cleanup uses (spec 6.9): a routine
# snapshot is never marked, so nothing writes a mark tonight, and the pass that
# does is what makes the fork sources of any fork taken since the last run
# protected before snapper's algorithms see them. Same key as
# guarden-snapper-cleanup.service, because snapper takes no lock that
# `snapper modify` participates in and its cleaner reuses one reference to the
# snapshot list across all three passes.
ExecStart=/usr/bin/flock -w 30 /run/guarden/locks/snapshots.lock /usr/lib/guarden/bin/weedr pin sync
