# {{ container }} of {{ service }}.

[Unit]
{% for line in unit_keys %}
{{ line }}
{% endfor %}

[Container]
{% for line in container_keys %}
{{ line }}
{% endfor %}
{% if service_keys %}

[Service]
{% for line in service_keys %}
{{ line }}
{% endfor %}
{% endif %}
