}

preview_cap() {
  local cap="${GUARDEN_PREVIEW_CAP:-3}"
  case "$cap" in
    ''|*[!0-9]*) cap=3 ;;
  esac
  if [ "$cap" -lt 1 ]; then
    cap=3
  fi
  echo "$cap"
}

fifo_add() {
  local project="$1" ref="$2"
  mkdir -p "$FIFO_DIR"
  if [ -f "$FIFO_DIR/$project" ] && grep -qFx "$ref" "$FIFO_DIR/$project"; then
    return 0
  fi
  echo "$ref" >> "$FIFO_DIR/$project"
}

fifo_remove() {
  local project="$1" ref="$2"
  [ -f "$FIFO_DIR/$project" ] || return 0
  grep -vFx "$ref" "$FIFO_DIR/$project" > "$FIFO_DIR/$project.tmp" || true
  mv "$FIFO_DIR/$project.tmp" "$FIFO_DIR/$project"
}

source_pond_for() {
  local project="$1" bed pond db role
  for bed in "$(bed_id_for production "$project")" "$(bed_id_for staging "$project")"; do
    [ -f "$BEDS_DIR/$bed/meta" ] || continue
    pond="$(meta_get "$BEDS_DIR/$bed/meta" pond)"
    db="$(meta_get "$BEDS_DIR/$bed/meta" ponddb)"
    role="$(meta_get "$BEDS_DIR/$bed/meta" pondrole)"
    if [ -n "$pond" ] && [ -n "$db" ]; then
      echo "$pond $db $role"
      return 0
    fi
  done
  return 0
}

candidate_ponds_for() {
  local project="$1" bed="$2" ref="${3:-}"
  local pond other
  pond="$(meta_get "$(instance_meta_path "$bed" "$ref")" pond)"
  if [ -n "$pond" ]; then
    echo "$pond"
  fi
  for other in "$(bed_id_for staging "$project")" "$(bed_id_for production "$project")"; do
    [ -f "$BEDS_DIR/$other/meta" ] || continue
    pond="$(meta_get "$BEDS_DIR/$other/meta" pond)"
    if [ -n "$pond" ]; then
      echo "$pond"
    fi
  done
}

instance_seed() {
  local project="$1" bed="$2" ref="${3:-}" from="$4"
  local meta pond bed_user envval src src_pond src_db src_role
  meta="$(instance_meta_path "$bed" "$ref")"
  if [ -n "$(meta_get "$meta" snapshot)" ]; then
    return 0
  fi
  local candidates=() cand production_target=0
  mapfile -t candidates < <(candidate_ponds_for "$project" "$bed" "$ref")
  pond=""
  for cand in ${candidates[@]+"${candidates[@]}"}; do
    if pond_is_production "$cand"; then
      production_target=1
      continue
    fi
    pond="$cand"
    break
  done
  if [ -z "$pond" ]; then
    if [ "$production_target" -eq 1 ]; then
      echo "weedr: warning: $(instance_holder "$bed" "$ref") was left with an empty database: no non-production pond is connected and seeding into a production pond is not automatic" >&2
    fi
    return 0
  fi
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  envval=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  meta_set "$meta" pond "$pond"
  write_hyphae "$bed_user" "$pond.internal"
  local declared_line db_name role_name grants_value key db role
  declared_line="$(pond_schema_parse "$BEDS_DIR/$bed/.guarden/bed.yaml")"
  db_name="$(printf '%s' "$declared_line" | cut -f1)"
  role_name="$(printf '%s' "$declared_line" | cut -f2)"
  grants_value="$(printf '%s' "$declared_line" | cut -f3)"
  key="$(instance_key "$bed" "$ref")"
  db="${db_name}_${key}"
  role="${role_name}_${key}"
  src="$(source_pond_for "$project")"
  src_pond="$(printf '%s' "$src" | cut -d' ' -f1)"
  src_db="$(printf '%s' "$src" | cut -d' ' -f2)"
  src_role="$(printf '%s' "$src" | cut -d' ' -f3)"
  if [ -z "$src_pond" ] || [ -z "$src_db" ] || { [ "$src_pond" = "$pond" ] && [ "$src_db" = "$db" ]; }; then
    pond_fill_body "$bed" "$pond" "$ref"
    return 0
  fi
  local snap holder out dump globals
  snap="$(snapshot_id)"
  holder="$(instance_holder "$bed" "$ref")"
  stakes pin "$snap" --holder "$holder"
  pond_fill_body "$bed" "$pond" "$ref"
  role="$(meta_get "$meta" pondrole)"
  db="$(meta_get "$meta" ponddb)"
  out="$(pond_psql "$pond" -tAc "SELECT 1 FROM pg_roles WHERE rolname = '${src_role}'")"
  if [ -z "$out" ]; then
    pond_psql "$pond" -c "CREATE ROLE ${src_role}"
  fi
  dump="$(mktemp)"
  globals="$(mktemp)"
  runuser -u "$src_pond" -- podman exec "$src_pond" pg_dump -U postgres "$src_db" > "$dump"
  runuser -u "$src_pond" -- podman exec "$src_pond" pg_dumpall --globals-only > "$globals"
  pond_psql "$pond" -c "DROP DATABASE IF EXISTS ${db}"
  pond_psql "$pond" -c "CREATE DATABASE ${db} OWNER ${role}"
  runuser -u "$pond" -- podman exec -i "$pond" psql -U postgres -d "$db" < "$dump"
  pond_psql "$pond" -c "REASSIGN OWNED BY ${src_role} TO ${role}"
  pond_psql "$pond" -c "DROP ROLE IF EXISTS ${src_role}"
  pond_psql "$pond" -c "GRANT ${grants_value} ON DATABASE ${db} TO ${role}"
  rm -f "$dump" "$globals"
  meta_set "$meta" snapshot "$snap"
}

preview_drop_body() {
  local project="$1" ref="$2"
  local env bed_id instance_ref="" safe_ref=""
  env="$(preview_env_for "$ref")"
  bed_id="$(bed_id_for "$env" "$project")"
  if [ "$ref" != "develop" ]; then
    instance_ref="$ref"
    safe_ref="${ref//[:\/]/-}"
  fi
  if [ ! -d "$BEDS_DIR/$bed_id" ]; then
    echo "weedr: no such preview: $(instance_holder "$bed_id" "$instance_ref")" >&2
    exit 1
  fi
  if [ -n "$safe_ref" ] && [ ! -d "$BEDS_DIR/$bed_id/$safe_ref" ]; then
    echo "weedr: no such preview: $(instance_holder "$bed_id" "$instance_ref")" >&2
    exit 1
  fi
  local meta snap holder bed_user
  meta="$(instance_meta_path "$bed_id" "$instance_ref")"
  snap="$(meta_get "$meta" snapshot)"
  holder="$(instance_holder "$bed_id" "$instance_ref")"
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed_id/meta" | cut -d= -f2)
  stop_bed_units "$bed_id" "$instance_ref"
  pond_drain_body "$bed_id" "" "$instance_ref" 1
  if [ -n "$snap" ]; then
    stakes unpin "$snap" --holder "$holder"
  fi
  fifo_remove "$project" "$ref"
  if [ -z "$safe_ref" ]; then
    teardown_bed "$bed_id"
    roots sync
    twig sync
    echo "dropped preview: $holder"
    return 0
  fi
  local units_dir f d remaining=0
  units_dir="$HOMES_DIR/$bed_user/.config/containers/systemd"
  rm -rf "$BEDS_DIR/$bed_id/$safe_ref" "$HOMES_DIR/$bed_user/$safe_ref"
  for f in "$units_dir"/*-"$safe_ref".container "$units_dir"/*-"$safe_ref".container.d; do
    [ -e "$f" ] || continue
    rm -rf "$f"
  done
  for d in "$BEDS_DIR/$bed_id"/*; do
    [ -d "$d" ] || continue
    case "$(basename "$d")" in
      .guarden) continue ;;
    esac
    remaining=$((remaining + 1))
  done
  if [ "$remaining" -eq 0 ]; then
    teardown_bed "$bed_id"
  fi
  roots sync
  twig sync
  echo "dropped preview: $holder"
}

cmd_preview_new() {
  shift 2
  local project="" ref="" from="." sha=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref)
        if [ $# -lt 2 ]; then
          echo "weedr preview new: --ref requires a value" >&2
          exit 2
        fi
        ref="$2"
        shift 2
        ;;
      --from)
        if [ $# -lt 2 ]; then
          echo "weedr preview new: --from requires a value" >&2
          exit 2
        fi
        from="$2"
        shift 2
        ;;
      --sha)
        if [ $# -lt 2 ]; then
          echo "weedr preview new: --sha requires a value" >&2
          exit 2
        fi
        sha="$2"
        shift 2
        ;;
      -*) echo "weedr: unknown option: $1" >&2; exit 2 ;;
      *)
        if [ -z "$project" ]; then
          project="$1"
        else
          echo "weedr: unexpected argument: $1" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done
  if [ -z "$project" ] || [ -z "$ref" ]; then
    echo "weedr preview new: requires <project> and --ref" >&2
    exit 2
  fi
  if [ -n "$sha" ] && ! valid_sha "$sha"; then
    echo "weedr: malformed sha: $sha" >&2
    exit 2
  fi
  if [ ! -d "$from" ]; then
    echo "weedr: no such source dir: $from" >&2
    exit 1
  fi
  if ! validate_manifest "$from/.guarden/bed.yaml"; then
    exit 2
  fi
  local env bed_id instance_ref="" safe_ref="" created=0
  env="$(preview_env_for "$ref")"
  bed_id="$(bed_id_for "$env" "$project")"
  if [ "$ref" != "develop" ]; then
    instance_ref="$ref"
    safe_ref="${ref//[:\/]/-}"
  fi
  local bed_user units_dir schema existed=0
  [ -d "$BEDS_DIR/$bed_id" ] && existed=1
  bed_plow_body "$project" "$env" "$from"
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed_id/meta" | cut -d= -f2)
  units_dir="$HOMES_DIR/$bed_user/.config/containers/systemd"
  schema="$BEDS_DIR/$bed_id/.guarden/.env.schema"
  if [ -n "$safe_ref" ]; then
    if [ ! -d "$BEDS_DIR/$bed_id/$safe_ref" ]; then
      created=1
    fi
    copy_manifests_into_bed "$from" "$bed_id" "$env" "$instance_ref"
    sync_units_from_source "$from" "$units_dir" "$env" "$instance_ref"
    if [ ! -f "$BEDS_DIR/$bed_id/$safe_ref/meta" ]; then
      {
        echo "project=$project"
        echo "env=$env"
        echo "user=$bed_user"
        echo "ref=$instance_ref"
      } > "$BEDS_DIR/$bed_id/$safe_ref/meta"
    fi
    if [ -f "$schema" ] && [ ! -f "$HOMES_DIR/$bed_user/$safe_ref/.env" ]; then
      materialize_env "$bed_user" "$schema" "$(env_class "$env")" "$from" "$env" "$instance_ref"
    fi
  elif [ "$existed" -eq 0 ]; then
    created=1
  fi
  instance_seed "$project" "$bed_id" "$instance_ref" "$from"
  if run_gate "$bed_id" start "$instance_ref"; then
    start_bed_units "$bed_id" "$instance_ref"
    echo "started bed: $bed_id"
  fi
  if [ -n "$sha" ]; then
    record_deployed_sha "$bed_id" "$instance_ref" "$sha"
  fi
  roots sync
  twig sync
  if [ -n "$instance_ref" ]; then
    fifo_add "$project" "$ref"
    local cap fifo oldest
    cap="$(preview_cap)"
    fifo="$FIFO_DIR/$project"
    while [ -f "$fifo" ] && [ "$(wc -l < "$fifo")" -gt "$cap" ]; do
      oldest="$(head -1 "$fifo")"
      preview_drop_body "$project" "$oldest"
    done
  fi
  if [ "$created" -eq 1 ]; then
    echo "created preview: $(instance_holder "$bed_id" "$instance_ref")"
  else
    echo "converged preview: $(instance_holder "$bed_id" "$instance_ref")"
  fi
}

cmd_preview_drop() {
  shift 2
  local project="" ref=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref)
        if [ $# -lt 2 ]; then
          echo "weedr preview drop: --ref requires a value" >&2
          exit 2
        fi
        ref="$2"
        shift 2
        ;;
      -*) echo "weedr: unknown option: $1" >&2; exit 2 ;;
      *)
        if [ -z "$project" ]; then
          project="$1"
        else
          echo "weedr: unexpected argument: $1" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done
  if [ -z "$project" ] || [ -z "$ref" ]; then
    echo "weedr preview drop: requires <project> and --ref" >&2
    exit 2
  fi
  preview_drop_body "$project" "$ref"
}

compose_services_dump() {
  python3 - "$1" <<'PYEOF'
import sys
path = sys.argv[1]
svcs = {}
in_services = False
current = None
try:
    f = open(path)
except OSError:
    sys.exit(0)
with f:
    for line in f:
        raw = line.rstrip("\n")
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip())
        if indent == 0:
            in_services = (stripped == "services:")
            current = None
            continue
        if not in_services:
            continue
        if indent == 2 and stripped.endswith(":"):
            current = stripped[:-1]
            svcs[current] = {"image": "", "ports": []}
            continue
        if current and indent == 4:
            if stripped.startswith("image:"):
                svcs[current]["image"] = stripped.split(":", 1)[1].strip().strip("\"'")
            elif stripped == "ports:":
                svcs[current]["ports"] = []
            elif stripped.startswith("- ") and isinstance(svcs[current]["ports"], list) and stripped not in ("ports:",):
                pass
        if current and indent >= 6 and stripped.startswith("- "):
            entry = stripped.lstrip("- ").strip().strip("\"'")
            if ":" in entry:
                svcs[current]["ports"].append(entry)
for name in sorted(svcs):
    print("%s\t%s\t%s" % (name, svcs[name]["image"], ",".join(svcs[name]["ports"])))
PYEOF
}

changed_services() {
  python3 - "$1" "$2" <<'PYEOF'
import sys

def parse(path):
    svcs = {}
    try:
        f = open(path)
    except OSError:
        return svcs
    in_services = False
    current = None
    with f:
        for line in f:
            raw = line.rstrip("\n")
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            indent = len(raw) - len(raw.lstrip())
            if indent == 0:
                in_services = (stripped == "services:")
                current = None
                continue
            if not in_services:
                continue
            if indent == 2 and stripped.endswith(":"):
                current = stripped[:-1]
                svcs[current] = {"image": "", "ports": []}
                continue
            if current and indent == 4 and stripped.startswith("image:"):
                svcs[current]["image"] = stripped.split(":", 1)[1].strip().strip("\"'")
            if current and indent >= 6 and stripped.startswith("- "):
                entry = stripped.lstrip("- ").strip().strip("\"'")
                if ":" in entry:
                    svcs[current]["ports"].append(entry)
    return svcs

old = parse(sys.argv[1])
new = parse(sys.argv[2])
for name in sorted(set(old) | set(new)):
    if old.get(name) != new.get(name):
        print(name)
PYEOF
}

all_services() {
  compose_services_dump "$1" | cut -f1
}

cmd_redeploy() {
  shift
  local project="" from="" yes=0 env="" instance_ref="" sha=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --env)
        if [ $# -lt 2 ]; then
          echo "weedr redeploy: --env requires a value" >&2
          exit 2
        fi
        env="$2"
        shift 2
        ;;
      --ref)
        if [ $# -lt 2 ]; then
          echo "weedr redeploy: --ref requires a value" >&2
          exit 2
        fi
        instance_ref="$2"
        shift 2
        ;;
      --from)
        if [ $# -lt 2 ]; then
          echo "weedr redeploy: --from requires a value" >&2
          exit 2
        fi
        from="$2"
        shift 2
        ;;
      --sha)
        if [ $# -lt 2 ]; then
          echo "weedr redeploy: --sha requires a value" >&2
          exit 2
        fi
        sha="$2"
        shift 2
        ;;
      --yes) yes=1; shift ;;
      -*) echo "weedr: unknown option: $1" >&2; exit 2 ;;
      *)
        if [ -n "$project" ]; then
          echo "weedr: unexpected argument: $1" >&2
          exit 2
        fi
        project="$1"
        shift
        ;;
    esac
  done
  if [ -z "$project" ]; then
    echo "weedr redeploy: requires <project>" >&2
    exit 2
  fi
  if [ -n "$instance_ref" ] && [ "$env" != "preview" ]; then
    echo "weedr redeploy: --ref targets a preview instance; use --env preview" >&2
    exit 2
  fi
  if [ -n "$sha" ] && ! valid_sha "$sha"; then
    echo "weedr: malformed sha: $sha" >&2
    exit 2
  fi
  resolve_bed_arg "$project" "$env"
  local bed="$RESOLVED_BED"
  local env_meta bed_user class
  env_meta=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  class="$(env_class "$env_meta")"
  if [ -n "$instance_ref" ] && [ "$env_meta" != "preview" ]; then
    echo "weedr redeploy: --ref targets a preview instance: $bed is $env_meta" >&2
    exit 2
  fi
  if [ "$class" = "production" ] && [ "$yes" -ne 1 ]; then
    echo "weedr: refusing to redeploy production bed without --yes: $bed" >&2
    exit 2
  fi
  if [ -n "$from" ] && [ ! -d "$from" ]; then
    echo "weedr: no such source dir: $from" >&2
    exit 1
  fi

  local safe_ref=""
  if [ -n "$instance_ref" ]; then
    safe_ref="${instance_ref//[:\/]/-}"
  fi
  run_gate "$bed" redeploy "$safe_ref" || exit 1

  local units_dir="$HOMES_DIR/$bed_user/.config/containers/systemd"
  local instances=() d
  if [ "$env_meta" = "preview" ]; then
    if [ -n "$safe_ref" ]; then
      if [ ! -d "$BEDS_DIR/$bed/$safe_ref" ]; then
        echo "weedr: no such preview instance: $bed/$safe_ref" >&2
        exit 1
      fi
      instances+=("$safe_ref")
    else
      for d in "$BEDS_DIR/$bed"/*; do
        [ -d "$d" ] || continue
        case "$(basename "$d")" in
          .guarden) continue ;;
        esac
        [ -f "$d/meta" ] || continue
        instances+=("$(basename "$d")")
      done
      if [ -n "$from" ]; then
        copy_manifests_into_bed "$from" "$bed" "$env_meta"
      fi
    fi
  else
    instances+=("")
  fi

  local inst ref inst_dir backup had_compose
  for inst in ${instances[@]+"${instances[@]}"}; do
    ref="$inst"
    inst_dir="$BEDS_DIR/$bed"
    if [ -n "$ref" ]; then
      inst_dir="$inst_dir/$ref"
    fi
    backup="$(mktemp -d)"
    had_compose=0
    if [ -f "$inst_dir/compose.yaml" ]; then
      cp "$inst_dir/compose.yaml" "$backup/compose.yaml"
      had_compose=1
    fi
    if [ -d "$inst_dir/.guarden" ]; then
      cp -r "$inst_dir/.guarden" "$backup/.guarden"
    fi

    local changed=()
    if [ -n "$from" ]; then
      if [ -f "$from/compose.yaml" ]; then
        mapfile -t changed < <(changed_services "$backup/compose.yaml" "$from/compose.yaml")
      fi
      copy_manifests_into_bed "$from" "$bed" "$env_meta" "$ref"
      sync_units_from_source "$from" "$units_dir" "$env_meta" "$ref"
    else
      mapfile -t changed < <(all_services "$inst_dir/compose.yaml")
    fi

    local svc unit suffix=""
    if [ -n "$ref" ]; then
      suffix="-$ref"
    fi
    for svc in ${changed[@]+"${changed[@]}"}; do
      [ -n "$svc" ] || continue
      unit="${svc}${suffix}.service"
      runuser -u "$bed_user" -- systemctl --user stop "$unit" || true
      if ! runuser -u "$bed_user" -- systemctl --user start "$unit"; then
        if [ "$had_compose" -eq 1 ]; then
          cp "$backup/compose.yaml" "$inst_dir/compose.yaml"
        else
          rm -f "$inst_dir/compose.yaml"
        fi
        if [ -d "$backup/.guarden" ]; then
          rm -rf "$inst_dir/.guarden"
          cp -r "$backup/.guarden" "$inst_dir/.guarden"
        else
          rm -rf "$inst_dir/.guarden"
        fi
        rm -rf "$backup"
        echo "weedr: unit $unit failed to start; leaving unit failed and routes unchanged: $bed" >&2
        exit 1
      fi
    done
    if [ -n "$sha" ]; then
      record_deployed_sha "$bed" "$ref" "$sha"
    fi
    rm -rf "$backup"
  done
  roots sync
  twig sync
  echo "redeployed bed: $bed"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  bed)
    case "${2:-}" in
      list) cmd_bed_list "$@" ;;
      plow) cmd_bed_plow "$@" ;;
      start) cmd_bed_start "$@" ;;
      stop) cmd_bed_stop "$@" ;;
      restart) cmd_bed_restart "$@" ;;
      remove) cmd_bed_remove "$@" ;;
      new)
        echo "weedr bed new was removed; use: weedr bed plow <project> --env <env>" >&2
        exit 2
        ;;
      drop)
        echo "weedr bed drop was removed; use: weedr bed remove <project> --env <env>" >&2
        exit 2
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  secret)
    case "${2:-}" in
      set) cmd_secret_set "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  pond)
    case "${2:-}" in
      ""|-h|--help)
        pond_usage
        exit 0
        ;;
      dig) cmd_pond_dig "$@" ;;
      fill) cmd_pond_fill "$@" ;;
      drain) cmd_pond_drain "$@" ;;
      mint) cmd_pond_mint "$@" ;;
      drop) cmd_pond_drop "$@" ;;
      restore) cmd_pond_restore "$@" ;;
      *) pond_usage >&2; exit 2 ;;
    esac
    ;;
  preview)
    case "${2:-}" in
      new) cmd_preview_new "$@" ;;
      drop) cmd_preview_drop "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  redeploy)
    cmd_redeploy "$@" ;;
  *)
    usage >&2
    exit 2
    ;;
esac
