  parse_target_args stop "$@"
  if [ -z "$TARGET_REF" ]; then
    echo "weedr bed stop: requires <project>" >&2
    exit 2
  fi
  resolve_bed_arg "$TARGET_REF" "$TARGET_ENV"
  bed_stop_body "$RESOLVED_BED"
}

cmd_bed_restart() {
  shift 2
  parse_target_args restart "$@"
  if [ -z "$TARGET_REF" ]; then
    echo "weedr bed restart: requires <project>" >&2
    exit 2
  fi
  resolve_bed_arg "$TARGET_REF" "$TARGET_ENV"
  bed_restart_body "$RESOLVED_BED"
}

remove_bed_volumes() {
  local bed="$1"
  local bed_user
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  local units_dir="$HOMES_DIR/$bed_user/.config/containers/systemd"
  for f in "$units_dir"/*.volume; do
    [ -e "$f" ] || continue
    runuser -u "$bed_user" -- podman volume rm -f "$(basename "$f" .volume)"
  done
}

teardown_bed() {
  local bed="$1"
  local bed_user joined
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  remove_bed_volumes "$bed"
  userdel "$bed_user"
  local names=()
  joined="$(sed -n 's/^hyphae=//p' "$BEDS_DIR/$bed/meta" 2>/dev/null || true)"
  if [ -n "$joined" ]; then
    IFS=',' read -r -a names <<< "$joined"
  else
    mapfile -t names < <(hyphae_names_for "$bed_user" "$bed" "$BEDS_DIR/$bed")
  fi
  remove_hyphae "$bed_user" "${names[@]}"
  rm -rf "$BEDS_DIR/$bed" "$HOMES_DIR/$bed_user"
}

cmd_bed_remove() {
  shift 2
  parse_target_args remove "$@"
  if [ -z "$TARGET_REF" ]; then
    echo "weedr bed remove: requires <project>" >&2
    exit 2
  fi
  resolve_bed_arg "$TARGET_REF" "$TARGET_ENV"
  local bed="$RESOLVED_BED"
  local env class
  env=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  class="$(env_class "$env")"
  if [ "$class" = "production" ] && [ "$TARGET_YES" -ne 1 ]; then
    echo "weedr: refusing to remove production bed without --yes: $bed" >&2
    exit 2
  fi
  stop_bed_units "$bed"
  teardown_bed "$bed"
  echo "removed bed: $bed"
}

cmd_secret_set() {
  shift 2
  local bed="${1:-}" key="${2:-}"
  if [ -z "$bed" ]; then
    echo "weedr secret set: requires <bed>" >&2
    exit 2
  fi
  if [ ! -d "$BEDS_DIR/$bed" ]; then
    echo "weedr: no such bed: $bed" >&2
    exit 1
  fi
  local env bed_user
  env=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  if [ -z "$key" ]; then
    local schema="$BEDS_DIR/$bed/.guarden/.env.schema"
    if [ ! -f "$schema" ]; then
      echo "nothing missing: $bed"
      return 0
    fi
    local rc=0 out=""
    out="$(check_prod_gate "$HOMES_DIR/$bed_user" "$schema" "$(env_class "$env")" "$env")" || rc=$?
    if [ "$rc" -eq 0 ]; then
      echo "nothing missing: $bed"
    else
      echo "$out"
    fi
    return 0
  fi
  local value
  value=$(cat)
  local local_file="$HOMES_DIR/$bed_user/.env.${env//[:\/]/-}.local"
  if [ -f "$local_file" ]; then
    grep -v "^${key}=" "$local_file" > "$local_file.tmp" || true
    mv "$local_file.tmp" "$local_file"
  fi
  echo "${key}=${value}" >> "$local_file"
  echo "set ${key} in bed: $bed"
}

plant_database_url() {
  local bed_user="$1" env="$2" role="$3" password="$4" pond="$5" db="$6" ref="${7:-}"
  local safe_env="${env//[:\/]/-}"
  local home="$HOMES_DIR/$bed_user"
  if [ -n "$ref" ]; then
    home="$home/${ref//[:\/]/-}"
  fi
  mkdir -p "$home"
  local local_file="$home/.env.${safe_env}.local"
  if [ -f "$local_file" ]; then
    grep -v "^DATABASE_URL=" "$local_file" > "$local_file.tmp" || true
    mv "$local_file.tmp" "$local_file"
  fi
  echo "DATABASE_URL=postgres://${role}:${password}@${pond}.internal:5432/${db}" >> "$local_file"
}

clear_database_url() {
  local bed_user="$1" env="$2" ref="${3:-}"
  local safe_env="${env//[:\/]/-}"
  local home="$HOMES_DIR/$bed_user"
  if [ -n "$ref" ]; then
    home="$home/${ref//[:\/]/-}"
  fi
  local local_file="$home/.env.${safe_env}.local"
  if [ -f "$local_file" ]; then
    grep -v "^DATABASE_URL=" "$local_file" > "$local_file.tmp" || true
    mv "$local_file.tmp" "$local_file"
  fi
}

pond_usage() {
  cat <<'EOF'
usage: weedr pond <command>

weedr pond — named shared-state instances on the bed schema with the class
prefix swapped. A pond owns its own user, quadlet dir and data directory; beds
get one database and one role inside a pond, never a container of their own.

commands:
  pond dig <name>              create a pond (name is pond-<env>-<name>)
  pond fill <bed> [-p <pond>]  provision a database and role for a bed
  pond drain <bed> [-p <pond>] remove them (production asks first)
EOF
}

cmd_pond_dig() {
  shift 2
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "weedr pond dig: requires <name>" >&2
    exit 2
  fi
  if [ $# -gt 1 ]; then
    echo "weedr: unexpected argument: $2" >&2
    exit 2
  fi
  pond_dig_body "$name"
}

parse_pond_target_args() {
  local verb="$1"
  shift
  POND_ARG_BED=""
  POND_ARG_ENV=""
  POND_ARG_POND=""
  POND_ARG_REF=""
  POND_ARG_YES=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --env)
        if [ $# -lt 2 ]; then
          echo "weedr pond $verb: --env requires a value" >&2
          exit 2
        fi
        POND_ARG_ENV="$2"
        shift 2
        ;;
      -p|--pond)
        if [ $# -lt 2 ]; then
          echo "weedr pond $verb: $1 requires a value" >&2
          exit 2
        fi
        POND_ARG_POND="$2"
        shift 2
        ;;
      --ref)
        if [ $# -lt 2 ]; then
          echo "weedr pond $verb: --ref requires a value" >&2
          exit 2
        fi
        POND_ARG_REF="$2"
        shift 2
        ;;
      --yes) POND_ARG_YES=1; shift ;;
      -*) echo "weedr: unknown option: $1" >&2; exit 2 ;;
      *)
        if [ -n "$POND_ARG_BED" ]; then
          echo "weedr: unexpected argument: $1" >&2
          exit 2
        fi
        POND_ARG_BED="$1"
        shift
        ;;
    esac
  done
  if [ -z "$POND_ARG_BED" ]; then
    echo "weedr pond $verb: requires <bed>" >&2
    exit 2
  fi
}

cmd_pond_fill() {
  shift 2
  parse_pond_target_args fill "$@"
  resolve_bed_arg "$POND_ARG_BED" "$POND_ARG_ENV"
  pond_fill_body "$RESOLVED_BED" "$POND_ARG_POND" "$POND_ARG_REF"
}

cmd_pond_drain() {
  shift 2
  parse_pond_target_args drain "$@"
  resolve_bed_arg "$POND_ARG_BED" "$POND_ARG_ENV"
  pond_drain_body "$RESOLVED_BED" "$POND_ARG_POND" "$POND_ARG_REF" "$POND_ARG_YES"
}

pond_removed_verb() {
  local verb="$1" replacement="$2"
  echo "weedr pond $verb was removed; use: $replacement" >&2
  exit 2
}

cmd_pond_mint() {
  pond_removed_verb mint "weedr pond fill <bed>"
}

cmd_pond_drop() {
  pond_removed_verb drop "weedr pond drain <bed>"
