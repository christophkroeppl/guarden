#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
BEDS_DIR="$STATE/beds"
HOMES_DIR="$STATE/homes"
HOSTS_FILE="$STATE/hosts"
PONDS_DIR="$STATE/ponds"
FIFO_DIR="$STATE/previews"

usage() {
  cat <<'EOF'
usage: weedr <command> [args]

weedr — the admin CLI that creates and removes beds and services without gitops.
The only privileged mutator.

commands:
  bed list
  bed plow <project> --env <env> [--from <dir>] [-p <pond>] [--sha <sha>] [--yes]
  bed start <project> --env <env>
  bed stop <project> --env <env>
  bed restart <project> --env <env>
  bed remove <project> --env <env> [--yes]
  secret set <bed> [KEY]
  redeploy <project> --env <env> [--ref <ref>] [--from <dir>] [--sha <sha>] [--yes]
  pond dig <name>
  pond fill <bed> [-p <pond>] [--ref <ref>]
  pond drain <bed> [-p <pond>] [--ref <ref>] [--yes]
  preview new <project> --ref <ref> [--from <dir>] [--sha <sha>]
  preview drop <project> --ref <ref>

pond names are pond-<env>-<name> (pond-production-postgres); a bed connects to
one at plow time with -p/--pond, and an unknown name offers to dig it (--yes).

previews: one bed per project (bed-preview-<project>) with one nested instance
per ref under /home/bed-preview-<project>/<ref>/; concurrent refs are capped at
3 per project by default (GUARDEN_PREVIEW_CAP) with FIFO eviction of the oldest.

--sha <sha> on bed plow, redeploy, and preview new records the deployed sha in
the target bed or instance meta; redeploy --ref <ref> targets one preview
instance and leaves its siblings alone.
EOF
}

sanitize() {
  echo "${1//[:\/]/-}"
}

valid_env() {
  case "$1" in
    production|staging|preview|fence) return 0 ;;
    *) return 1 ;;
  esac
}

env_error() {
  echo "weedr: unknown environment: $1 (expected production|staging|preview|fence)" >&2
}

bed_id_for() {
  local env name
  env="$(sanitize "$1")"
  name="$(sanitize "$2")"
  echo "bed-${env}-${name}"
}

env_class() {
  case "$1" in
    production|fence) echo production ;;
    *) echo nonprod ;;
  esac
}

RESOLVED_BED=""

resolve_bed_arg() {
  local ref="$1" env="${2:-}"
  local bed="$ref"
  if [ -n "$env" ]; then
    if ! valid_env "$env"; then
      env_error "$env"
      exit 2
    fi
    bed="$(bed_id_for "$env" "$ref")"
    if [ ! -d "$BEDS_DIR/$bed" ] && [ -d "$BEDS_DIR/$ref" ]; then
      bed="$ref"
    fi
  fi
  if [ ! -d "$BEDS_DIR/$bed" ]; then
    echo "weedr: no such bed: $bed" >&2
    exit 1
  fi
  RESOLVED_BED="$bed"
}

TARGET_REF=""
TARGET_ENV=""
TARGET_YES=0

parse_target_args() {
  local verb="$1"
  shift
  TARGET_REF=""
  TARGET_ENV=""
  TARGET_YES=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --env)
        if [ $# -lt 2 ]; then
          echo "weedr bed $verb: --env requires a value" >&2
          exit 2
        fi
        TARGET_ENV="$2"
        shift 2
        ;;
      --yes) TARGET_YES=1; shift ;;
      -*) echo "weedr: unknown option: $1" >&2; exit 2 ;;
      *)
        if [ -n "$TARGET_REF" ]; then
          echo "weedr: unexpected argument: $1" >&2
          exit 2
        fi
        TARGET_REF="$1"
        shift
        ;;
    esac
  done
}

validate_manifest() {
  local file="$1" key envval
  if [ ! -f "$file" ]; then
    echo "weedr: missing manifest: $file" >&2
    return 1
  fi
  while IFS= read -r key; do
    case "$key" in
      environment|routes|auth|pond|hyphae|ports|repo) ;;
      *)
        echo "weedr: $file: unknown key: $key" >&2
        return 1
        ;;
    esac
  done < <(awk -F: '/^[A-Za-z_]/ { print $1 }' "$file")
  envval="$(awk '/^environment:/ { sub(/^environment:[ \t]*/, ""); sub(/[ \t]*#.*/, ""); gsub(/["\047]/, ""); print; exit }' "$file")"
  if [ -z "$envval" ]; then
    echo "weedr: $file: missing environment" >&2
    return 1
  fi
  if ! valid_env "$envval"; then
    echo "weedr: $file: unknown environment: $envval" >&2
    return 1
  fi
  return 0
}

meta_get() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  sed -n "s/^${key}=//p" "$file" | head -1
}

meta_set() {
  local file="$1" key="$2" value="$3"
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || : > "$file"
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    grep -v "^${key}=" "$file" > "$file.tmp" || true
    mv "$file.tmp" "$file"
  fi
  echo "${key}=${value}" >> "$file"
}

meta_del() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  if grep -q "^${key}=" "$file" 2>/dev/null; then
    grep -v "^${key}=" "$file" > "$file.tmp" || true
    mv "$file.tmp" "$file"
  fi
}

instance_meta_path() {
  local bed="$1" ref="${2:-}"
  if [ -n "$ref" ]; then
    echo "$BEDS_DIR/$bed/${ref//[:\/]/-}/meta"
  else
    echo "$BEDS_DIR/$bed/meta"
  fi
}

instance_holder() {
  local bed="$1" ref="${2:-}"
  if [ -n "$ref" ]; then
    echo "$bed/${ref//[:\/]/-}"
  else
    echo "$bed"
  fi
}

valid_sha() {
  [[ "$1" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]
}

record_deployed_sha() {
  local bed="$1" ref="${2:-}" sha="$3"
  meta_set "$(instance_meta_path "$bed" "$ref")" sha "$sha"
}

parse_pond_id() {
  local id="$1" rest envname
  case "$id" in
    pond-*) ;;
    *) return 1 ;;
  esac
  rest="${id#pond-}"
  envname="${rest%%-*}"
  if [ -z "$envname" ] || [ "$envname" = "$rest" ]; then
    return 1
  fi
  if ! valid_env "$envname"; then
    return 1
  fi
  POND_ENV="$envname"
  POND_NAME="${rest#*-}"
  if [ -z "$POND_NAME" ]; then
    return 1
  fi
  return 0
}

pond_is_production() {
  parse_pond_id "$1" || return 1
  [ "$POND_ENV" = "production" ]
}

pond_ids() {
  local d
  [ -d "$PONDS_DIR" ] || return 0
  for d in "$PONDS_DIR"/*; do
    [ -d "$d" ] || continue
    basename "$d"
  done
}

known_ponds() {
  local ids id out=""
  ids="$(pond_ids)"
  if [ -z "$ids" ]; then
    echo "  (none)"
    return 0
  fi
  while IFS= read -r id; do
    [ -n "$id" ] && out="${out}  ${id}
"
  done <<< "$ids"
  printf '%s' "$out"
}

pg_ident() {
  echo "${1//-/_}"
}

instance_key() {
  local bed="$1" ref="${2:-}"
  local key
  key="$(pg_ident "$bed")"
  if [ -n "$ref" ]; then
    key="${key}_$(pg_ident "$ref")"
  fi
  echo "$key"
}

pond_schema_parse() {
  local file="$1"
  awk '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    BEGIN { db = ""; role = ""; grants = ""; seen = 0 }
    /^pond:/ { seen = 1; next }
    seen == 0 { next }
    /^[^ \t]/ { exit }
    /^  databases:/ {
      if (match($0, /\[/)) {
        line = substr($0, RSTART + 1)
        sub(/\].*/, "", line)
        sub(/[ \t].*/, "", line)
        gsub(/["\047]/, "", line)
        db = trim(line)
        next
      }
      in_db = 1
      next
    }
    in_db && /^  [^ \t]/ { in_db = 0; in_roles = 0 }
    in_db && db == "" && /^    [^ \t]/ {
      line = $0
      sub(/^    /, "", line)
      sub(/:.*/, "", line)
      db = trim(line)
      next
    }
    in_db && /^      roles:/ { in_roles = 1; next }
    in_roles && role == "" && /- name:/ {
      line = $0
      sub(/.*- name:[ \t]*/, "", line)
      role = trim(line)
      next
    }
    in_roles && grants == "" && /grants:/ {
      line = $0
      sub(/.*grants:[ \t]*/, "", line)
      sub(/\].*/, "", line)
      sub(/^[ \t]*\[/, "", line)
      gsub(/["\047 ]/, "", line)
      grants = trim(line)
      next
    }
    END {
      if (db == "") db = "app"
      if (role == "") role = db
      if (grants == "") grants = "ALL"
      printf "%s\t%s\t%s\n", db, role, grants
    }
  ' "$file" 2>/dev/null || printf 'app\tapp\tALL\n'
}

pond_psql() {
  local pond="$1"
  shift
  runuser -u "$pond" -- podman exec "$pond" psql -U postgres "$@"
}

pond_block_index() {
  local pond="$1" meta stored i c h=0 g n=0
  meta="$PONDS_DIR/$pond/meta"
  stored="$(sed -n 's/^block=//p' "$meta" 2>/dev/null || true)"
  stored="${stored%%$'\n'*}"
  if [ -n "$stored" ]; then
    printf '%s\n' "$stored"
    return 0
  fi
  for ((i = 0; i < ${#pond}; i++)); do
    printf -v c '%d' "'${pond:i:1}"
    h=$(( (h * 31 + c) % 256 ))
  done
  g="$h"
  while pond_block_taken "$pond" "$g" && [ "$n" -lt 256 ]; do
    g=$(( (g + 1) % 256 ))
    n=$((n + 1))
  done
  printf '%s\n' "$g"
}

pond_block_taken() {
  local pond="$1" g="$2" other
  for other in "$PONDS_DIR"/*/meta; do
    [ -f "$other" ] || continue
    if [ "$other" = "$PONDS_DIR/$pond/meta" ]; then
      continue
    fi
    if grep -qx "block=$g" "$other" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

hyphae_addr_for() {
  local name="$1" pond block
  case "$name" in
    pond-*.internal)
      pond="${name%.internal}"
      if [ -f "$PONDS_DIR/$pond/meta" ]; then
        block="$(pond_block_index "$pond")"
        printf '127.1.%s.1\n' "$block"
        return 0
      fi
      ;;
  esac
  printf '127.0.0.1\n'
}

write_hyphae() {
  local bed_user="$1"
  shift
  mkdir -p "$(dirname "$HOSTS_FILE")"
  local name addr
  for name in "$@"; do
    if ! grep -qF " ${name}" "$HOSTS_FILE" 2>/dev/null; then
      addr="$(hyphae_addr_for "$name")"
      echo "$addr ${name}" >> "$HOSTS_FILE"
    fi
  done
}

remove_hyphae() {
  local bed_user="$1"
  shift
  local names=("$@")
  if [ -f "$HOSTS_FILE" ]; then
    local tmp
    tmp="$(mktemp)"
    for name in "${names[@]}"; do
      grep -vF " ${name}" "$HOSTS_FILE" > "$tmp" || true
      mv "$tmp" "$HOSTS_FILE"
    done
  fi
}

hyphae_names_for() {
  local bed_user="$1" bed_name="$2" project_dir="${3:-}"
  local names=("${bed_user}.internal")
  if [ -n "$project_dir" ] && [ -f "$project_dir/.guarden/bed.yaml" ]; then
    local aliases
    aliases=$(sed -n '/^hyphae:/,/^[^ ]/p' "$project_dir/.guarden/bed.yaml" | grep -oP '(?<=aliases:\s\[)[^]]*' | tr ',' '\n' | tr -d ' "' || true)
    while IFS= read -r alias; do
      [ -n "$alias" ] && names+=("$alias")
    done <<< "$aliases"
  fi
  printf '%s\n' "${names[@]}"
}

compose_to_quadlet() {
  local compose_file="$1" output_dir="$2"
  if command -v podlet >/dev/null 2>&1; then
    podlet compose -f "$compose_file" -d "$output_dir"
  else
    echo "podlet compose -f $compose_file" >> "${GUARDEN_CALL_LOG:-/dev/null}"
  fi
  emit_bare_volume_units "$compose_file" "$output_dir"
}

emit_bare_volume_units() {
  local compose_file="$1" output_dir="$2"
  python3 - "$compose_file" "$output_dir" <<'PYEOF'
import sys, os
compose_path, output_dir = sys.argv[1], sys.argv[2]
def bare_volumes(path):
    vols = []
    in_volumes = False
    current = None
    current_bare = True
    with open(path) as f:
        for line in f:
            raw = line.rstrip('\n')
            stripped = raw.strip()
            if not stripped or stripped.startswith('#'):
                continue
            indent = len(raw) - len(raw.lstrip())
            if indent == 0:
                if current and current_bare:
                    vols.append(current)
                in_volumes = (stripped == 'volumes:')
                current = None
                current_bare = True
                continue
            if not in_volumes:
                continue
            if indent == 2:
                if current and current_bare:
                    vols.append(current)
                if ':' in stripped:
                    name, _, rest = stripped.partition(':')
                    current = name.strip()
                    current_bare = rest.strip() in ('', '{}', 'null', '~')
                else:
                    current = stripped
                    current_bare = True
            elif indent > 2 and current:
                current_bare = False
    if current and current_bare:
        vols.append(current)
    return vols
os.makedirs(output_dir, exist_ok=True)
for vol in bare_volumes(compose_path):
    vol_path = os.path.join(output_dir, vol + '.volume')
    if not os.path.exists(vol_path):
        with open(vol_path, 'w') as f:
            f.write('[Volume]\n')
PYEOF
}

write_dropins() {
  local units_dir="$1" env="$2" ref="${3:-}"
  local safe_env="${env//[:\/]/-}"
  local suffix=""
  if [ -n "$ref" ]; then
    suffix="-${ref//[:\/]/-}"
  fi
  local env_home="%h"
  if [ -n "$ref" ]; then
    env_home="%h/${ref//[:\/]/-}"
  fi
  for f in "$units_dir"/*"$suffix".container; do
    [ -e "$f" ] || continue
    local base
    base="$(basename "$f" .container)"
    local dropin_dir="$units_dir/${base}.container.d"
    mkdir -p "$dropin_dir"
    cat > "$dropin_dir/bed.env" <<EOF
[Container]
EnvironmentFile=$env_home/.env
EnvironmentFile=-$env_home/.env.${safe_env}
EnvironmentFile=-$env_home/.env.${safe_env}.local
EOF
  done
}

rand_hex() {
  head -c 16 /dev/urandom | od -A n -t x | tr -d ' \n'
}

materialize_env() {
  local bed_user="$1" schema_file="$2" class="$3" project_dir="$4" env="$5" ref="${6:-}"
  local bed_home="$HOMES_DIR/$bed_user"
  if [ -n "$ref" ]; then
    bed_home="$bed_home/${ref//[:\/]/-}"
  fi
  mkdir -p "$bed_home"
  local out_file="$bed_home/.env"
  : > "$out_file"
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    local key="${line%%=*}"
    local rest="${line#*=}"
    local value="${rest%%@*}"
    value="${value%"${value##*[![:space:]]}"}"
    local has_sensitive=0
    [[ "$rest" == *@sensitive* ]] && has_sensitive=1
    if [ "$has_sensitive" -eq 1 ] && [ "$class" = "nonprod" ]; then
      echo "${key}=$(rand_hex)" >> "$out_file"
    elif [ "$has_sensitive" -eq 1 ]; then
      echo "${key}=" >> "$out_file"
    else
      echo "${key}=${value}" >> "$out_file"
    fi
  done < "$schema_file"
  local safe_env="${env//[:\/]/-}"
  for layer in ".env" ".env.${safe_env}" ".env.${safe_env}.local"; do
    if [ -f "$project_dir/$layer" ]; then
      cp "$project_dir/$layer" "$bed_home/$layer"
    fi
  done
}

generate_env_example() {
  local schema_file="$1" out_file="$2"
  : > "$out_file"
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    local key="${line%%=*}"
    local rest="${line#*=}"
    local value="${rest%%@*}"
    value="${value%"${value##*[![:space:]]}"}"
    local ann="${rest#*@}"
    local has_sensitive=0 has_example="" has_required=0
    [[ "$rest" == *@sensitive* ]] && has_sensitive=1
    [[ "$rest" == *@required* ]] && has_required=1
    if [[ "$rest" == *@example* ]]; then
      has_example=$(echo "$rest" | grep -oP '(?<=@example\s)\S+' || true)
    fi
    if [ "$has_sensitive" -eq 1 ]; then
      if [ -n "$has_example" ]; then
        echo "${key}=${has_example}" >> "$out_file"
      else
        echo "${key}=EXAMPLE-${key}" >> "$out_file"
      fi
    elif [ -n "$value" ]; then
      echo "${key}=${value}" >> "$out_file"
    elif [ "$has_required" -eq 1 ]; then
      echo "${key}=EXAMPLE-${key}" >> "$out_file"
    else
      echo "${key}=" >> "$out_file"
    fi
  done < "$schema_file"
}

rewrite_bed_env() {
  local file="$1" env="$2"
  [ -f "$file" ] || return 0
  [ -n "$env" ] || return 0
  awk -v env="$env" '
    BEGIN { done = 0 }
    /^environment:/ && done == 0 { print "environment: " env; done = 1; next }
    { print }
    END { if (done == 0) print "environment: " env }
  ' "$file" > "$file.tmp"
  mv "$file.tmp" "$file"
}

copy_manifests_into_bed() {
  local from="$1" bed="$2" env="${3:-}" ref="${4:-}"
  local dst="$BEDS_DIR/$bed"
  if [ -n "$ref" ]; then
    dst="$dst/${ref//[:\/]/-}"
  fi
  mkdir -p "$dst"
  local keep_compose=1
  if [ -z "$ref" ] && [ "$env" = "preview" ]; then
    keep_compose=0
  fi
  if [ -f "$from/compose.yaml" ] && [ "$keep_compose" -eq 1 ]; then
    cp "$from/compose.yaml" "$dst/compose.yaml"
  else
    rm -f "$dst/compose.yaml"
  fi
  mkdir -p "$dst/.guarden"
  if [ -f "$from/.guarden/bed.yaml" ]; then
    cp "$from/.guarden/bed.yaml" "$dst/.guarden/bed.yaml"
    rewrite_bed_env "$dst/.guarden/bed.yaml" "$env"
  else
    rm -f "$dst/.guarden/bed.yaml"
  fi
  if [ -f "$from/.guarden/.env.schema" ]; then
    cp "$from/.guarden/.env.schema" "$dst/.guarden/.env.schema"
  else
    rm -f "$dst/.guarden/.env.schema"
  fi
  if [ -n "$ref" ]; then
    return 0
  fi
  if [ -d "$from/.guarden/widgets" ] && [ -n "$(ls -A "$from/.guarden/widgets")" ]; then
    rm -rf "$dst/.guarden/widgets"
    cp -r "$from/.guarden/widgets" "$dst/.guarden/widgets"
  else
    rm -rf "$dst/.guarden/widgets"
  fi
}

sync_units_from_source() {
  local from="$1" units_dir="$2" env="$3" ref="${4:-}"
  local safe_ref=""
  if [ -n "$ref" ]; then
    safe_ref="${ref//[:\/]/-}"
  fi
  mkdir -p "$units_dir"
  if [ -f "$from/compose.yaml" ]; then
    if [ -n "$safe_ref" ]; then
      local tmp
      tmp="$(mktemp -d)"
      if command -v podlet >/dev/null 2>&1; then
        podlet compose -f "$from/compose.yaml" -d "$tmp"
      else
        echo "podlet compose -f $from/compose.yaml" >> "${GUARDEN_CALL_LOG:-/dev/null}"
      fi
      local f base
      for f in "$tmp"/*.container; do
        [ -e "$f" ] || continue
        base="$(basename "$f" .container)"
        mv "$f" "$units_dir/${base}-${safe_ref}.container"
      done
      rm -rf "$tmp"
      emit_bare_volume_units "$from/compose.yaml" "$units_dir"
    else
      compose_to_quadlet "$from/compose.yaml" "$units_dir"
    fi
  fi
  if [ -d "$from/.guarden/quadlet" ]; then
    if [ -n "$safe_ref" ]; then
      local q base
      for q in "$from/.guarden/quadlet"/*; do
        [ -e "$q" ] || continue
        base="$(basename "$q")"
        case "$base" in
          *.container)
            cp "$q" "$units_dir/${base%.container}-${safe_ref}.container"
            ;;
          *)
            if [ ! -e "$units_dir/$base" ]; then
              cp "$q" "$units_dir/$base"
            fi
            ;;
        esac
      done
    else
      cp -r "$from/.guarden/quadlet/." "$units_dir/"
    fi
  fi
  write_dropins "$units_dir" "$env" "$ref"
}

record_hyphae_meta() {
  local bed="$1"
  shift
  local names=("$@")
  local meta="$BEDS_DIR/$bed/meta"
  local joined
  joined="$(IFS=,; echo "${names[*]}")"
  if grep -q '^hyphae=' "$meta" 2>/dev/null; then
    grep -v '^hyphae=' "$meta" > "$meta.tmp" || true
    mv "$meta.tmp" "$meta"
  fi
  echo "hyphae=$joined" >> "$meta"
}

forget_hyphae_meta() {
  local bed="$1"
  local meta="$BEDS_DIR/$bed/meta"
  local joined
  joined="$(sed -n 's/^hyphae=//p' "$meta" 2>/dev/null || true)"
  if [ -z "$joined" ]; then
    return 0
  fi
  local old_names=()
  IFS=',' read -r -a old_names <<< "$joined"
  remove_hyphae "$bed" "${old_names[@]}"
}

bed_plow_body() {
  local project="$1" env="$2" from="$3"
  local bed_id bed_user bed_home units_dir created=0
  bed_id="$(bed_id_for "$env" "$project")"
  bed_user="$bed_id"
  bed_home="$HOMES_DIR/$bed_user"
  units_dir="$bed_home/.config/containers/systemd"
  local schema="$from/.guarden/.env.schema"

  if [ ! -d "$BEDS_DIR/$bed_id" ]; then
    created=1
    mkdir -p "$BEDS_DIR/$bed_id"
  fi
  mkdir -p "$units_dir"

  if [ "$created" -eq 1 ]; then
    {
      echo "project=$project"
      echo "env=$env"
      echo "user=$bed_user"
    } > "$BEDS_DIR/$bed_id/meta"
    useradd --system --create-home --home-dir "$bed_home" "$bed_user"
    loginctl enable-linger "$bed_user"
    echo "$bed_user:100000:65536" >> "$STATE/subuid"
    echo "$bed_user:100000:65536" >> "$STATE/subgid"
    if [ -f "$schema" ]; then
      generate_env_example "$schema" "$from/.env.example"
      materialize_env "$bed_user" "$schema" "$(env_class "$env")" "$from" "$env"
    fi
  else
    if [ -f "$schema" ]; then
      generate_env_example "$schema" "$from/.env.example"
    fi
    forget_hyphae_meta "$bed_id"
  fi

  local names=()
  mapfile -t names < <(hyphae_names_for "$bed_user" "$bed_id" "$from")
  write_hyphae "$bed_user" "${names[@]}"
  record_hyphae_meta "$bed_id" "${names[@]}"

  if [ "$env" != "preview" ]; then
    sync_units_from_source "$from" "$units_dir" "$env"
  fi
  copy_manifests_into_bed "$from" "$bed_id" "$env"

  if [ "$created" -eq 1 ]; then
    echo "created bed: $bed_id"
  else
    echo "converged bed: $bed_id"
  fi
}

pond_dig_body() {
  local id="$1"
  if ! parse_pond_id "$id"; then
    echo "weedr: pond name must be pond-<env>-<name> (production|staging|preview|fence): $id" >&2
    exit 2
  fi
  local env="$POND_ENV" created=0
  local pond_home="$HOMES_DIR/$id"
  local units_dir="$pond_home/.config/containers/systemd"
  if [ ! -d "$PONDS_DIR/$id" ]; then
    created=1
    mkdir -p "$PONDS_DIR/$id/data"
    mkdir -p "$pond_home"
    {
      echo "name=$id"
      echo "env=$env"
      echo "user=$id"
    } > "$PONDS_DIR/$id/meta"
    useradd --system --create-home --home-dir "$pond_home" "$id"
    loginctl enable-linger "$id"
    echo "$id:100000:65536" >> "$STATE/subuid"
    echo "$id:100000:65536" >> "$STATE/subgid"
    chown "$id" "$PONDS_DIR/$id/data" 2>/dev/null || true
    mkdir -p "$units_dir"
  else
    mkdir -p "$units_dir" "$PONDS_DIR/$id/data"
  fi
  local block addr
  block="$(pond_block_index "$id")"
  if ! grep -q '^block=' "$PONDS_DIR/$id/meta" 2>/dev/null; then
    echo "block=$block" >> "$PONDS_DIR/$id/meta"
  fi
  addr="127.1.$block.1"
  cat > "$units_dir/$id.container" <<EOF
[Container]
Image=docker.io/library/postgres:17
PublishPort=$addr:5432:5432
Volume=$PONDS_DIR/$id/data:/var/lib/postgresql/data:Z
Environment=POSTGRES_HOST_AUTH_METHOD=trust
EOF
  write_hyphae "$id" "$id.internal"
  runuser -u "$id" -- systemctl --user start "$id.service"
  if [ "$created" -eq 1 ]; then
    echo "dug pond: $id"
  else
    echo "converged pond: $id"
  fi
}

pond_fill_body() {
  local bed="$1" pond="${2:-}" ref="${3:-}"
  local meta bed_user envval key role db password
  meta="$(instance_meta_path "$bed" "$ref")"
  if [ ! -f "$BEDS_DIR/$bed/meta" ]; then
    echo "weedr: no such bed: $bed" >&2
    exit 1
  fi
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  envval=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  if [ -z "$pond" ]; then
    pond="$(meta_get "$meta" pond)"
  fi
  if [ -z "$pond" ]; then
    echo "weedr: bed is not connected to a pond: $bed" >&2
    echo "known ponds:" >&2
    known_ponds >&2
    echo "connect one with: weedr pond fill $bed -p <pond>" >&2
    exit 1
  fi
  if [ ! -d "$PONDS_DIR/$pond" ]; then
    echo "weedr: no such pond: $pond" >&2
    echo "known ponds:" >&2
    known_ponds >&2
    exit 1
  fi
  local existing
  existing="$(meta_get "$meta" ponddb)"
  if [ -n "$existing" ]; then
    echo "pond database present: $existing in $pond"
    return 0
  fi
  local declared_line db_name role_name grants_value
  declared_line="$(pond_schema_parse "$BEDS_DIR/$bed/.guarden/bed.yaml")"
  db_name="$(printf '%s' "$declared_line" | cut -f1)"
  role_name="$(printf '%s' "$declared_line" | cut -f2)"
  grants_value="$(printf '%s' "$declared_line" | cut -f3)"
  key="$(instance_key "$bed" "$ref")"
  db="${db_name}_${key}"
  role="${role_name}_${key}"
  password="$(rand_hex)"
  local out
  out="$(pond_psql "$pond" -tAc "SELECT 1 FROM pg_roles WHERE rolname = '${role}'")"
  if [ -z "$out" ]; then
    pond_psql "$pond" -c "CREATE ROLE ${role} LOGIN PASSWORD '${password}'"
  fi
  pond_psql "$pond" -c "CREATE DATABASE ${db} OWNER ${role}"
  pond_psql "$pond" -c "GRANT ${grants_value} ON DATABASE ${db} TO ${role}"
  write_hyphae "$bed_user" "$pond.internal"
  plant_database_url "$bed_user" "$envval" "$role" "$password" "$pond" "$db" "$ref"
  meta_set "$meta" pond "$pond"
  meta_set "$meta" ponddb "$db"
  meta_set "$meta" pondrole "$role"
  unset password
  echo "filled pond database: $db in $pond"
}

pond_drain_body() {
  local bed="$1" pond="${2:-}" ref="${3:-}" yes="${4:-0}"
  local meta bed_user envval db role
  meta="$(instance_meta_path "$bed" "$ref")"
  if [ ! -f "$BEDS_DIR/$bed/meta" ]; then
    echo "weedr: no such bed: $bed" >&2
    exit 1
  fi
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  envval=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  if [ -z "$pond" ]; then
    pond="$(meta_get "$meta" pond)"
  fi
  db="$(meta_get "$meta" ponddb)"
  role="$(meta_get "$meta" pondrole)"
  if [ -z "$db" ] || [ -z "$pond" ]; then
    echo "nothing to drain: $bed"
    return 0
  fi
  if [ ! -d "$PONDS_DIR/$pond" ]; then
    echo "weedr: no such pond: $pond" >&2
    exit 1
  fi
  if [ "$(env_class "$envval")" = "production" ] && [ "$yes" -ne 1 ]; then
    echo "weedr: refusing to drain production database without --yes: $bed" >&2
    exit 2
  fi
  pond_psql "$pond" -c "DROP DATABASE IF EXISTS ${db}"
  pond_psql "$pond" -c "DROP ROLE IF EXISTS ${role}"
  clear_database_url "$bed_user" "$envval" "$ref"
  meta_del "$meta" ponddb
  meta_del "$meta" pondrole
  meta_del "$meta" snapshot
  echo "drained pond database: $db from $pond"
}

pond_connect_bed() {
  local bed="$1" pond="$2" yes="${3:-0}" from="${4:-}"
  local bed_user meta
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  meta="$BEDS_DIR/$bed/meta"
  if [ ! -d "$PONDS_DIR/$pond" ]; then
    if [ "$yes" -ne 1 ]; then
      echo "weedr: no such pond: $pond" >&2
      echo "known ponds:" >&2
      known_ponds >&2
      echo "dig it with: weedr pond dig $pond (or re-run with --yes)" >&2
      exit 1
    fi
    pond_dig_body "$pond"
  fi
  write_hyphae "$bed_user" "$pond.internal"
  meta_set "$meta" pond "$pond"
  if [ -n "$from" ] && [ -z "$(meta_get "$meta" ponddb)" ]; then
    pond_fill_body "$bed" "$pond"
  fi
  echo "connected bed: $bed to $pond"
}

cmd_bed_plow() {
  shift 2
  local project="" env="" from="." pond="" yes=0 sha=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --env)
        if [ $# -lt 2 ]; then
          echo "weedr bed plow: --env requires a value" >&2
          exit 2
        fi
        env="$2"
        shift 2
        ;;
      --from)
        if [ $# -lt 2 ]; then
          echo "weedr bed plow: --from requires a value" >&2
          exit 2
        fi
        from="$2"
        shift 2
        ;;
      --sha)
        if [ $# -lt 2 ]; then
          echo "weedr bed plow: --sha requires a value" >&2
          exit 2
        fi
        sha="$2"
        shift 2
        ;;
      -p|--pond)
        if [ $# -lt 2 ]; then
          echo "weedr bed plow: $1 requires a value" >&2
          exit 2
        fi
        pond="$2"
        shift 2
        ;;
      --yes) yes=1; shift ;;
      -*) echo "weedr: unknown option: $1" >&2; exit 2 ;;
      *)
        if [ -z "$project" ]; then
          project="$1"
        else
          echo "weedr: unexpected argument: $1" >&2
          exit 2
        fi
        shift
        ;;
    esac
  done
  if [ -z "$project" ] || [ -z "$env" ]; then
    echo "weedr bed plow: requires <project> and --env" >&2
    exit 2
  fi
  if ! valid_env "$env"; then
    env_error "$env"
    exit 2
  fi
  if [ ! -d "$from" ]; then
    echo "weedr: no such source dir: $from" >&2
    exit 1
  fi
  if [ -n "$pond" ] && ! parse_pond_id "$pond"; then
    echo "weedr: pond name must be pond-<env>-<name> (production|staging|preview|fence): $pond" >&2
    exit 2
  fi
  if [ -n "$sha" ] && ! valid_sha "$sha"; then
    echo "weedr: malformed sha: $sha" >&2
    exit 2
  fi
  if ! validate_manifest "$from/.guarden/bed.yaml"; then
    exit 2
  fi
  bed_plow_body "$project" "$env" "$from"
  if [ -n "$pond" ]; then
    pond_connect_bed "$(bed_id_for "$env" "$project")" "$pond" "$yes" "$from"
  fi
  if [ -n "$sha" ]; then
    record_deployed_sha "$(bed_id_for "$env" "$project")" "" "$sha"
  fi
}

cmd_bed_list() {
  shift 2
  local d bed envval
  for d in "$BEDS_DIR"/*/meta; do
    [ -f "$d" ] || continue
    bed="$(basename "$(dirname "$d")")"
    envval="$(sed -n 's/^env=//p' "$d" | head -1)"
    echo "$bed $envval"
  done
}

resolve_env_value() {
  local bed_home="$1" env="$2" key="$3"
  local safe_env="${env//[:\/]/-}"
  local val=""
  for layer in ".env" ".env.${safe_env}" ".env.${safe_env}.local"; do
    if [ -f "$bed_home/$layer" ]; then
      local v
      v=$(grep "^${key}=" "$bed_home/$layer" | tail -1 | cut -d= -f2- || true)
      [ -n "$v" ] && val="$v"
    fi
  done
  echo "$val"
}

check_prod_gate() {
  local bed_home="$1" schema_file="$2" class="$3" env="$4"
  local errors=0
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    local key="${line%%=*}"
    local rest="${line#*=}"
    local has_required=0
    [[ "$rest" == *@required* ]] && has_required=1
    [ "$has_required" -eq 0 ] && continue
    local val
    val="$(resolve_env_value "$bed_home" "$env" "$key")"
    if [ -z "$val" ]; then
      echo "missing: $key"
      errors=$((errors + 1))
    elif [[ "$val" == EXAMPLE-* ]] || [[ "$val" == changeme* ]]; then
      echo "example value: $key"
      errors=$((errors + 1))
    fi
  done < "$schema_file"
  [ "$errors" -gt 0 ] && return 1
  return 0
}

run_gate() {
  local bed="$1" action="$2" ref="${3:-}"
  local env class schema bed_user bed_home
  env=$(grep '^env=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  class="$(env_class "$env")"
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  bed_home="$HOMES_DIR/$bed_user"
  if [ -n "$ref" ]; then
    bed_home="$bed_home/${ref//[:\/]/-}"
  fi
  schema="$BEDS_DIR/$bed/.guarden/.env.schema"
  if [ ! -f "$schema" ]; then
    return 0
  fi
  local rc=0 out=""
  out="$(check_prod_gate "$bed_home" "$schema" "$class" "$env")" || rc=$?
  if [ "$rc" -eq 0 ]; then
    return 0
  fi
  echo "$out" >&2
  if [ "$class" = "production" ]; then
    echo "weedr: refusing to ${action} bed: $bed (production gate)" >&2
    return 1
  fi
  echo "weedr: warning: gate issues on $bed" >&2
  return 0
}

unit_files_for() {
  local bed="$1" ref="${2:-}"
  local bed_user units_dir f suffix=""
  bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
  units_dir="$HOMES_DIR/$bed_user/.config/containers/systemd"
  if [ -n "$ref" ]; then
    suffix="-${ref//[:\/]/-}"
  fi
  for f in "$units_dir"/*"$suffix".container; do
    [ -e "$f" ] || continue
    echo "$f"
  done
}

start_bed_units() {
  local bed="$1" ref="${2:-}"
  local f
  local units=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    units+=("$(basename "$f" .container).service")
  done < <(unit_files_for "$bed" "$ref")
  if [ ${#units[@]} -gt 0 ]; then
    local bed_user
    bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
    runuser -u "$bed_user" -- systemctl --user start "${units[@]}"
  fi
}

stop_bed_units() {
  local bed="$1" ref="${2:-}"
  local f
  local units=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    units+=("$(basename "$f" .container).service")
  done < <(unit_files_for "$bed" "$ref")
  if [ ${#units[@]} -gt 0 ]; then
    local bed_user
    bed_user=$(grep '^user=' "$BEDS_DIR/$bed/meta" | cut -d= -f2)
    runuser -u "$bed_user" -- systemctl --user stop "${units[@]}"
  fi
}

bed_start_body() {
  local bed="$1" ref="${2:-}"
  run_gate "$bed" start "$ref" || exit 1
  start_bed_units "$bed" "$ref"
  echo "started bed: $bed"
}

bed_stop_body() {
  local bed="$1"
  stop_bed_units "$bed"
  echo "stopped bed: $bed"
}

bed_restart_body() {
  local bed="$1"
  run_gate "$bed" restart || exit 1
  stop_bed_units "$bed"
  echo "stopped bed: $bed"
  start_bed_units "$bed"
  echo "started bed: $bed"
}

cmd_bed_start() {
  shift 2
  parse_target_args start "$@"
  if [ -z "$TARGET_REF" ]; then
    echo "weedr bed start: requires <project>" >&2
    exit 2
  fi
  resolve_bed_arg "$TARGET_REF" "$TARGET_ENV"
  bed_start_body "$RESOLVED_BED"
}

cmd_bed_stop() {
