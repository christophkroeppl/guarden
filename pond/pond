#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
PONDS_DIR="$STATE/ponds"

usage() {
  cat <<'EOF'
usage: pond <command>

pond — reports the named shared-state instances (Postgres first) dug on this
host. Ponds are created, filled and drained through weedr; each one runs as its
own user pond-<env>-<name> and no shared pond user exists.

commands:
  list    list the ponds dug on this host

weedr pond dig <name>              create a pond (name is pond-<env>-<name>)
weedr pond fill <bed> [-p <pond>]  provision a database and role for a bed
weedr pond drain <bed> [-p <pond>] remove them (production asks first)
EOF
}

cmd_list() {
  local d id envval
  for d in "$PONDS_DIR"/*; do
    [ -d "$d" ] || continue
    id="$(basename "$d")"
    envval=""
    if [ -f "$d/meta" ]; then
      envval="$(sed -n 's/^env=//p' "$d/meta" | head -1)"
    fi
    echo "$id $envval"
  done
}

case "${1:-}" in
  list)
    cmd_list
    ;;
  ""|-h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
