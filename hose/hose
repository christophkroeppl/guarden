#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
BEDS_DIR="$STATE/beds"
STAGING_DIR="$STATE/staging"
SYSROOT="${GUARDEN_SYSROOT:-}"

usage() {
  cat <<'EOF'
usage: hose poke <project> <ref> <sha>
       hose drop <project> <ref>
       hose --help

hose — the gitops reconciler that waters beds from CI pokes. Keeps no git
state on the VPS: the source tree arrives as a tar.gz on stdin, is staged at
/var/lib/guarden/staging/<bed>/<sha>/ (0755, readable by the bed user), and is
handed to weedr through a narrow sudoers rule. Holds no privilege of its own.

commands:
  poke <project> <ref> <sha>   stage the source tree on stdin and converge the
                               bed: develop -> staging, main|master ->
                               production, any other ref -> preview instance
  drop <project> <ref>         drop a preview instance (previews only)

A poke whose sha equals the deployed sha in the bed meta is a no-op and
exits 0.
EOF
}

write_sudoers() {
  [ -n "$SYSROOT" ] || return 0
  mkdir -p "$SYSROOT/etc/sudoers.d"
  cat > "$SYSROOT/etc/sudoers.d/hose-weedr" <<'EOF'
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr bed plow *
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr preview new *
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr preview drop *
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr redeploy *
EOF
}

as_weedr() {
  sudo weedr "$@"
}

die() {
  echo "hose: $*" >&2
  exit 2
}

require_project() {
  case "$1" in
    ''|.*|-*) die "malformed project: $1" ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "malformed project: $1"
}

require_ref() {
  local ref="$1"
  [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] || die "malformed ref: $ref"
  case "$ref" in
    ''|.|*..*|-*|/*|*/) die "malformed ref: $ref" ;;
  esac
}

require_sha() {
  [[ "$1" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || die "malformed sha: $1"
}

target_env_for_ref() {
  case "$1" in
    develop) echo staging ;;
    main|master) echo production ;;
    *) echo preview ;;
  esac
}

safe_ref_for() {
  echo "${1//[:\/]/-}"
}

meta_path_for() {
  local bed="$1" safe_ref="$2"
  if [ -n "$safe_ref" ]; then
    echo "$BEDS_DIR/$bed/$safe_ref/meta"
  else
    echo "$BEDS_DIR/$bed/meta"
  fi
}

meta_get() {
  local file="$1" key="$2" line
  [ -f "$file" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "${key}="*)
        printf '%s\n' "${line#"${key}="}"
        return 0
        ;;
    esac
  done < "$file"
  return 0
}

stage_source() {
  local bed="$1" sha="$2"
  local stage="$STAGING_DIR/$bed/$sha"
  mkdir -p "$stage"
  if ! tar -xzf - -C "$stage"; then
    rm -rf "$stage"
    echo "hose: stdin is not a source tar.gz" >&2
    exit 1
  fi
  chmod 0755 "$STAGING_DIR" "$STAGING_DIR/$bed" "$stage"
  if [ -z "$(ls -A "$stage")" ]; then
    rm -rf "$stage"
    echo "hose: empty source tree" >&2
    exit 1
  fi
  echo "$stage"
}

converge() {
  local project="$1" env="$2" ref="$3" stage="$4" sha="$5"
  case "$env" in
    preview)
      if [ -d "$BEDS_DIR/bed-preview-$project/$(safe_ref_for "$ref")" ]; then
        as_weedr redeploy "$project" --env preview --ref "$ref" --from "$stage" --sha "$sha"
      else
        as_weedr preview new "$project" --ref "$ref" --from "$stage" --sha "$sha"
      fi
      ;;
    production)
      if [ -d "$BEDS_DIR/bed-production-$project" ]; then
        as_weedr redeploy "$project" --env production --from "$stage" --sha "$sha" --yes
      else
        as_weedr bed plow "$project" --env production --from "$stage" --sha "$sha"
      fi
      ;;
    staging)
      if [ -d "$BEDS_DIR/bed-staging-$project" ]; then
        as_weedr redeploy "$project" --env staging --from "$stage" --sha "$sha"
      else
        as_weedr preview new "$project" --ref develop --from "$stage" --sha "$sha"
      fi
      ;;
  esac
}

cmd_poke() {
  shift
  [ $# -eq 3 ] || die "poke requires <project> <ref> <sha>"
  local project="$1" ref="$2" sha="$3"
  require_project "$project"
  require_ref "$ref"
  require_sha "$sha"
  write_sudoers
  local env safe_ref meta deployed stage
  env="$(target_env_for_ref "$ref")"
  safe_ref=""
  if [ "$env" = "preview" ]; then
    safe_ref="$(safe_ref_for "$ref")"
  fi
  meta="$(meta_path_for "bed-$env-$project" "$safe_ref")"
  deployed="$(meta_get "$meta" sha)"
  if [ -n "$deployed" ] && [ "$deployed" = "$sha" ]; then
    echo "hose: $project $ref $sha already deployed"
    exit 0
  fi
  stage="$(stage_source "bed-$env-$project" "$sha")"
  converge "$project" "$env" "$ref" "$stage" "$sha"
  echo "hose: poked $project $ref $sha -> bed-$env-$project"
}

cmd_drop() {
  shift
  [ $# -eq 2 ] || die "drop requires <project> <ref>"
  local project="$1" ref="$2"
  require_project "$project"
  require_ref "$ref"
  case "$ref" in
    develop|main|master) die "drop only drops previews: $ref" ;;
  esac
  write_sudoers
  as_weedr preview drop "$project" --ref "$ref"
  echo "hose: dropped $project $ref"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  poke)
    cmd_poke "$@"
    ;;
  drop)
    cmd_drop "$@"
    ;;
  sync)
    echo "hose sync was removed; the only intake is: hose poke <project> <ref> <sha>" >&2
    exit 2
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
