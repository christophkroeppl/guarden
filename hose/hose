#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
BEDS_DIR="$STATE/beds"
SYSROOT="${GUARDEN_SYSROOT:-}"

usage() {
  cat <<'EOF'
usage: hose sync [--ops <file>] [--help]

hose — the gitops reconciler that waters beds from a git source of truth.
Calls weedr through a narrow sudoers rule; holds no privilege of its own.

commands:
  sync    reconcile beds from an explicit ops list of project repos
EOF
}

write_sudoers() {
  [ -n "$SYSROOT" ] || return 0
  mkdir -p "$SYSROOT/etc/sudoers.d"
  cat > "$SYSROOT/etc/sudoers.d/hose-weedr" <<'EOF'
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr preview new *
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr preview drop *
hose ALL=(root) NOPASSWD: /usr/local/bin/weedr redeploy *
EOF
}

as_weedr() {
  sudo weedr "$@"
}

bed_name_for() {
  local project="$1" ref="$2"
  if [ "$ref" = "develop" ]; then
    echo "${project}-staging"
  else
    echo "${project}-preview-${ref//[:\/]/-}"
  fi
}

manifests_differ() {
  local src="$1" bed="$2"
  if [ ! -f "$bed/compose.yaml" ]; then
    return 0
  fi
  diff -q "$src/compose.yaml" "$bed/compose.yaml" >/dev/null 2>&1 || return 0
  if [ -f "$src/bed.yaml" ] || [ -f "$bed/bed.yaml" ]; then
    diff -q "$src/bed.yaml" "$bed/bed.yaml" >/dev/null 2>&1 || return 0
  fi
  if [ -d "$src/widgets" ] || [ -d "$bed/widgets" ]; then
    diff -rq "$src/widgets" "$bed/widgets" >/dev/null 2>&1 || return 0
  fi
  return 1
}

reconcile_project() {
  local project="$1" repo="$2"
  git -C "$repo" pull --ff-only >/dev/null 2>&1 || git -C "$repo" fetch --all --prune >/dev/null 2>&1 || true
  local refs=()
  mapfile -t refs < <(git -C "$repo" for-each-ref refs/heads --format='%(refname:short)')
  local ref bed tmp
  for ref in ${refs[@]+"${refs[@]}"}; do
    case "$ref" in
      main|master) continue ;;
    esac
    bed="$(bed_name_for "$project" "$ref")"
    tmp="$(mktemp -d)"
    git -C "$repo" archive --format=tar "$ref" | tar -x -C "$tmp"
    if [ ! -d "$BEDS_DIR/$bed" ]; then
      as_weedr preview new "$project" --ref "$ref" --from "$tmp"
    elif manifests_differ "$tmp" "$BEDS_DIR/$bed"; then
      as_weedr redeploy "$bed" --from "$tmp"
    fi
    rm -rf "$tmp"
  done
  local d meta p env want found
  for d in "$BEDS_DIR"/*; do
    [ -d "$d" ] || continue
    [ -f "$d/meta" ] || continue
    meta="$d/meta"
    p=$(grep '^project=' "$meta" | cut -d= -f2)
    [ "$p" = "$project" ] || continue
    env=$(grep '^env=' "$meta" | cut -d= -f2)
    case "$env" in
      preview:*)
        want="${env#preview:}"
        found=0
        for ref in ${refs[@]+"${refs[@]}"}; do
          if [ "$ref" = "$want" ]; then
            found=1
          fi
        done
        if [ "$found" -eq 0 ]; then
          as_weedr preview drop "$project" --ref "$want"
        fi
        ;;
    esac
  done
}

cmd_sync() {
  shift
  local ops="$STATE/hose/ops"
  while [ $# -gt 0 ]; do
    case "$1" in
      --ops) ops="$2"; shift 2 ;;
      -*) echo "hose: unknown option: $1" >&2; exit 2 ;;
      *) echo "hose: unexpected argument: $1" >&2; exit 2 ;;
    esac
  done
  if [ ! -f "$ops" ]; then
    echo "hose: no such ops list: $ops" >&2
    exit 1
  fi
  write_sudoers
  local project repo
  while read -r project repo; do
    case "$project" in ''|'#'*) continue ;; esac
    [ -n "$repo" ] || continue
    if [ ! -d "$repo" ]; then
      echo "hose: no such repo: $repo" >&2
      exit 1
    fi
    reconcile_project "$project" "$repo"
  done < "$ops"
  echo "hose: synced from $ops"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  sync)
    cmd_sync "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
