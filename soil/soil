#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: soil <phase> --check | --apply [--deadman]

soil — host prep: btrfs convert, snapper ladders, ferm/fail2ban, podman/quadlet,
rootless prerequisites. Runs install-time convergers as root.

phases:
  users         shared-tier users and groups, fence group
  firewall      disable ufw, converge ferm and fail2ban
  sysctl        net.ipv4.ip_unprivileged_port_start=0
  btrfs         ext4 to btrfs convert, @ and @home subvolumes
  storage       volumes root, root and home ladders, apt hook
  root-scripts  root-owned copies of anything root executes
  units         podman, quadlet, base units

options:
  --check     report drift without changing the host; exit 1 when drift exists
  --apply     converge the host
  --deadman   with firewall --apply: arm a timer that restores firewall access
EOF
}

phase="${1:-}"
shift || true

mode=""
deadman=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check|--apply)
      mode="$1"
      ;;
    --deadman)
      deadman=1
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

case "$phase" in
  ""|-h|--help)
    usage
    exit 0
    ;;
esac

case "$mode" in
  --check|--apply) ;;
  *)
    usage >&2
    exit 2
    ;;
esac

case "$phase" in
  users|firewall|sysctl|btrfs|storage|root-scripts|units) ;;
  *)
    echo "soil: unknown phase: $phase" >&2
    exit 2
    ;;
esac

if [ "$deadman" -eq 1 ] && { [ "$phase" != "firewall" ] || [ "$mode" != "--apply" ]; }; then
  echo "soil: --deadman requires firewall --apply" >&2
  exit 2
fi

state="${GUARDEN_STATE:-/var/lib/guarden}"
sysroot="${GUARDEN_SYSROOT:-}"
marker="$state/soil/$phase.done"

if [ "$mode" = "--check" ]; then
  if [ -e "$marker" ]; then
    echo "ok: $phase"
    exit 0
  fi
  echo "drift: $phase"
  exit 1
fi

mkdir -p "$(dirname "$marker")"

case "$phase" in
  users)
    getent group fence >/dev/null 2>&1 || groupadd --system fence
    for u in roots stakes twig hose; do
      getent passwd "$u" >/dev/null 2>&1 || useradd --system --user-group --home-dir "/home/$u" --shell /usr/sbin/nologin "$u"
    done
    usermod -aG fence roots
    ;;
  firewall)
    apt-get install -y ferm fail2ban
    ufw disable
    systemctl disable --now ufw
    mkdir -p "$sysroot/etc/ferm" "$sysroot/etc/fail2ban/jail.d"
    cat > "$sysroot/etc/ferm/ferm.conf" <<'EOF'
domain (ip ip6) table filter chain INPUT {
  policy DROP;
  mod state state (ESTABLISHED RELATED) ACCEPT;
  interface lo ACCEPT;
  proto tcp dport (ssh http https) ACCEPT;
}
EOF
    ferm /etc/ferm/ferm.conf
    systemctl enable --now ferm
    cat > "$sysroot/etc/fail2ban/jail.d/guarden.local" <<'EOF'
[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
EOF
    systemctl enable --now fail2ban
    fail2ban-client reload
    if [ "$deadman" -eq 1 ]; then
      mkdir -p "$sysroot/usr/local/lib/guarden" "$sysroot/etc/systemd/system"
      cat > "$sysroot/usr/local/lib/guarden/deadman-restore" <<'EOF'
#!/bin/sh
set -e
systemctl stop guarden-deadman.timer
systemctl stop ferm || true
ufw --force disable
EOF
      chmod 0755 "$sysroot/usr/local/lib/guarden/deadman-restore"
      cat > "$sysroot/etc/systemd/system/guarden-deadman.service" <<'EOF'
[Unit]
Description=guarden dead-man firewall restore

[Service]
Type=oneshot
ExecStart=/usr/local/lib/guarden/deadman-restore
EOF
      cat > "$sysroot/etc/systemd/system/guarden-deadman.timer" <<'EOF'
[Unit]
Description=guarden dead-man firewall restore timer

[Timer]
OnActiveSec=15m
AccuracySec=1s
EOF
      systemctl daemon-reload
      systemctl start guarden-deadman.timer
    fi
    ;;
  sysctl)
    mkdir -p "$sysroot/etc/sysctl.d"
    echo "net.ipv4.ip_unprivileged_port_start=0" > "$sysroot/etc/sysctl.d/99-guarden.conf"
    sysctl -w net.ipv4.ip_unprivileged_port_start=0
    ;;
  btrfs)
    bstate_file="$state/soil/btrfs.state"
    reboot_marker="$state/soil/reboot-needed"
    bstate=""
    if [ -e "$bstate_file" ]; then
      bstate="$(cat "$bstate_file")"
    fi
    if [ "$bstate" = "converted" ]; then
      echo "no drift: btrfs"
    elif [ "$bstate" = "hook-staged" ]; then
      if [ ! -e "$reboot_marker" ]; then
        btrfs subvolume create "$sysroot/@" 2>/dev/null || btrfs subvolume show "$sysroot/@"
        btrfs subvolume create "$sysroot/@home" 2>/dev/null || btrfs subvolume show "$sysroot/@home"
        fstab="$sysroot/etc/fstab"
        fstab_src="UUID=root"
        if [ -e "$fstab" ]; then
          fstab_src="$(awk '$2=="/" {print $1; exit}' "$fstab")"
          awk '$2!="/" && $2!="/home"' "$fstab" > "$fstab.guarden"
          mv "$fstab.guarden" "$fstab"
        else
          mkdir -p "$sysroot/etc"
        fi
        [ -n "$fstab_src" ] || fstab_src="UUID=root"
        printf '%s / btrfs subvol=@,noatime,compress=zstd 0 0\n' "$fstab_src" >> "$fstab"
        printf '%s /home btrfs subvol=@home,noatime,compress=zstd 0 0\n' "$fstab_src" >> "$fstab"
        echo "converted" > "$bstate_file"
        bstate="converted"
      fi
    else
      mkdir -p "$sysroot/usr/lib/dracut/modules.d/99guarden-convert"
      cat > "$sysroot/usr/lib/dracut/modules.d/99guarden-convert/module-setup.sh" <<'EOF'
#!/bin/bash
check() {
  return 0
}
depends() {
  return 0
}
install() {
  inst_hook pre-mount 99 "$moddir/guarden-convert-hook.sh"
  if [ -e /var/lib/guarden/soil/reboot-needed ]; then
    inst_simple /var/lib/guarden/soil/reboot-needed /etc/guarden-convert.enable
  fi
}
EOF
      cat > "$sysroot/usr/lib/dracut/modules.d/99guarden-convert/guarden-convert-hook.sh" <<'EOF'
#!/bin/sh
ic_log() {
  echo "guarden-convert: $*"
}
[ -e /etc/guarden-convert.enable ] || return 0
ic_log "pre-mount hook fired"
ic_root="${root:-}"
ic_root="${ic_root#block:}"
case "$ic_root" in
  UUID=* | LABEL=* | PARTUUID=* | PARTLABEL=*) ic_dev="$(findfs "$ic_root" 2>/dev/null || true)" ;;
  /dev/*) ic_dev="$(readlink -f "$ic_root" 2>/dev/null || true)" ;;
  *) ic_dev="" ;;
esac
if [ -z "${ic_dev:-}" ] || [ ! -b "$ic_dev" ]; then
  ic_log "cannot resolve root device"
  return 0
fi
ic_type="$(blkid -p -s TYPE -o value "$ic_dev" 2>/dev/null || true)"
if [ "$ic_type" = ext4 ]; then
  ic_log "converting $ic_dev offline to btrfs"
  if btrfs-convert --uuid copy --copy-label --no-progress "$ic_dev"; then
    ic_log "conversion OK"
  else
    ic_log "conversion FAILED; roll back with btrfs-convert -r $ic_dev"
    return 0
  fi
fi
mkdir -p /guarden-root
if mount -t btrfs "$ic_dev" /guarden-root; then
  rm -f /guarden-root/var/lib/guarden/soil/reboot-needed
  sync
  umount /guarden-root
fi
return 0
EOF
      echo "reboot required to run the ext4 to btrfs pre-mount hook" > "$reboot_marker"
      echo "hook-staged" > "$bstate_file"
      bstate="hook-staged"
      dracut -f
    fi
    ;;
  storage)
    apt-get install -y snapper
    mkdir -p "$sysroot/var/lib/guarden" "$sysroot/etc/apt/apt.conf.d"
    btrfs subvolume create "$sysroot/var/lib/guarden/beds" 2>/dev/null || btrfs subvolume show "$sysroot/var/lib/guarden/beds"
    mkdir -p "$sysroot/var/lib/guarden/beds"
    mkdir -p "$sysroot/var/lib/roots/dynamic"
    chgrp fence "$sysroot/var/lib/roots/dynamic"
    chmod 2775 "$sysroot/var/lib/roots/dynamic"
    snapper -c root create-config / 2>/dev/null || true
    snapper -c home create-config /home 2>/dev/null || true
    for kv in NUMBER_CLEANUP=yes NUMBER_LIMIT=0-50 NUMBER_LIMIT_IMPORTANT=0-10 TIMELINE_CLEANUP=yes TIMELINE_LIMIT_HOURLY=0 TIMELINE_LIMIT_DAILY=1-7 TIMELINE_LIMIT_WEEKLY=1-4 TIMELINE_LIMIT_MONTHLY=1-3 TIMELINE_LIMIT_QUARTERLY=1-4 TIMELINE_LIMIT_YEARLY=0-1 EMPTY_PRE_POST_CLEANUP=yes FREE_LIMIT=0.12; do
      snapper -c root set-config "$kv"
    done
    for kv in NUMBER_CLEANUP=yes TIMELINE_CLEANUP=yes TIMELINE_LIMIT_HOURLY=0 TIMELINE_LIMIT_DAILY=0-7 TIMELINE_LIMIT_WEEKLY=0-4 TIMELINE_LIMIT_MONTHLY=0-3 TIMELINE_LIMIT_QUARTERLY=0-4 TIMELINE_LIMIT_YEARLY=0-1 EMPTY_PRE_POST_CLEANUP=yes FREE_LIMIT=0.20; do
      snapper -c home set-config "$kv"
    done
    cat > "$sysroot/etc/apt/apt.conf.d/80snapper" <<'EOF'
DPkg::Pre-Invoke {"if command -v snapper >/dev/null 2>&1 && snapper -c root list >/dev/null 2>&1; then snapper -c root create --description 'apt pre' --cleanup-algorithm number >/dev/null 2>&1 || true; fi";};
EOF
    ;;
  root-scripts)
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    mkdir -p "$sysroot/usr/local/bin"
    if [ -e "$here/../weedr/weedr" ]; then
      install -m 0755 "$here/soil" "$sysroot/usr/local/bin/soil"
      install -m 0755 "$here/../weedr/weedr" "$sysroot/usr/local/bin/weedr"
      install -m 0755 "$here/../stakes/stakes" "$sysroot/usr/local/bin/stakes"
    fi
    ;;
  units)
    podman --version
    ;;
esac

if [ "$phase" = btrfs ] && [ "${bstate:-}" = "hook-staged" ]; then
  echo "reboot required: btrfs"
else
  : > "$marker"
  echo "applied: $phase"
fi
