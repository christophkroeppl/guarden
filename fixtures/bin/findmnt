#!/usr/bin/env bash
# findmnt — /boot's filesystem, because /boot sharing the filesystem that becomes
# btrfs is how a conversion leaves a box with no kernel to boot.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "findmnt (guarden fake) 1.0"
        exit 0
        ;;
esac

fstype="$GUARDEN_FAKE_DIR/boot-fstype"
mkdir -p "$GUARDEN_FAKE_DIR"
[ -f "$fstype" ] || printf 'ext4\n' >"$fstype"
cat "$fstype"
