#!/usr/bin/env bash
# snapper — the one fake that answers.
#
# spec 8.2 and AGENTS.md: snapshot state is read with
# `snapper list --machine-readable json`, because JSON renders a snapshot's
# `userdata` as an object and `important` is therefore a key, while CSV renders
# the whole map as one comma-joined quoted field. A fake that answered only the
# human table would let a CSV parser pass its tests, so this one models all
# three renderings from the same seed, and the difference between them is the
# difference a test has to be able to see.
#
# The effective configuration is read with `get-config`, never by parsing
# /etc/snapper/configs/, and `modify` records the userdata it was handed, because
# a pin test that does not inspect the mark tests nothing.
#
# `create-config` and `set-config` are here because the mutator creates a
# service's configuration and writes its value set, and a fake that modelled
# neither would make "the mutator wrote the canonical set" and "soil storage
# converged it" the same untested claim.
#
# Seed a configuration's snapshots by writing records to
# $GUARDEN_FIXTURES/snapper/<config>.list, one per line:
#
#   number|cleanup|date|description|k=v,k=v
#
# and its configuration to $GUARDEN_FIXTURES/snapper/<config>.conf as KEY=value
# lines. Unseeded, `list` is empty and `get-config` is the canonical value set.

. "$(dirname "$0")/../lib/fake.sh"

fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "snapper (guarden fake) 1.0"
        exit 0
        ;;
esac

config=root
verb=
format=table
algorithm=
userdata=
merge_from=
subvolume=
records=()
extra=()
settings=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --version|-v)
            fake_out "snapper 0.11.2"
            exit 0
            ;;
        -c|--config)
            [ "$#" -ge 2 ] || fake_die "-c needs a configuration"
            config=$2
            shift 2
            ;;
        --machine-readable)
            [ "$#" -ge 2 ] || fake_die "--machine-readable needs a format"
            format=$2
            shift 2
            ;;
        --cleanup-algorithm)
            [ "$#" -ge 2 ] || fake_die "--cleanup-algorithm needs an algorithm"
            algorithm=$2
            shift 2
            ;;
        --userdata)
            [ "$#" -ge 2 ] || fake_die "--userdata needs a value"
            userdata=$2
            shift 2
            ;;
        --description)
            [ "$#" -ge 2 ] || fake_die "--description needs a value"
            extra+=("description=$2")
            shift 2
            ;;
        -p|--subvolume)
            [ "$#" -ge 2 ] || fake_die "-p needs a subvolume"
            subvolume=$2
            shift 2
            ;;
        -f|--file)
            [ "$#" -ge 2 ] || fake_die "-f needs a file"
            merge_from=$2
            shift 2
            ;;
        set-config)
            [ "$#" -ge 2 ] || fake_die "set-config needs a KEY=VALUE"
            verb=set-config
            settings+=("$2")
            shift 2
            ;;
        create-config)
            # snapper takes the subvolume either as a bare positional or with
            # -p, and both callers in guarden are real: soil runs
            # `create-config -f btrfs -p <mount>` and weedr runs
            # `create-config <subvolume>`. So this arm records the verb and
            # shifts one, and the positional that follows lands in `records`
            # through the `*)` arm below. Reading `$2` here instead would
            # capture `-f` from soil's form and reject the configuration as
            # "not a subvolume".
            verb=create-config
            shift
            ;;
        --)
            shift
            ;;
        -*)
            fake_die "unknown option $1"
            ;;
        *)
            if [ -z "$verb" ]; then
                verb=$1
            else
                records+=("$1")
            fi
            shift
            ;;
    esac
done

conf_dir=${GUARDEN_SNAPPER_CONFIGS:-}
if [ -z "$conf_dir" ] && [ -n "${GUARDEN_PREFIX:-}" ]; then
    conf_dir="$GUARDEN_PREFIX/etc/snapper/configs"
fi
conf_dir=${conf_dir:-$GUARDEN_FAKE_SNAPPER}
list_file="$GUARDEN_FAKE_SNAPPER/$config.list"
conf_file="$conf_dir/$config"
mkdir -p "$GUARDEN_FAKE_SNAPPER" "$conf_dir"

# The distribution's default template: the state before soil converges anything.
# The empty-pre/post cleaner is enabled and there is no minimum age, so a
# converge has something real to change.
default_config() {
    printf '%s\n' \
        "SUBVOLUME=$subvolume" \
        'FSTYPE=btrfs' \
        'EMPTY_PRE_POST_CLEANUP=yes' \
        'NUMBER_MIN_AGE=0' \
        'NUMBER_CLEANUP=yes' \
        'TIMELINE_CLEANUP=yes' \
        'TIMELINE_LIMIT_HOURLY=0' \
        'TIMELINE_LIMIT_DAILY=0-7' \
        'TIMELINE_LIMIT_WEEKLY=0-4' \
        'TIMELINE_LIMIT_MONTHLY=0-6' \
        'TIMELINE_LIMIT_QUARTERLY=0-2' \
        'TIMELINE_LIMIT_YEARLY=0' \
        'NUMBER_LIMIT=2-10' \
        'NUMBER_LIMIT_IMPORTANT=8-12' \
        'FREE_LIMIT=0.1' >"$conf_file"
}

# canonical_config: the value set the mutator writes with set-config, as a
# function rather than a literal in two places. Restored verbatim from ticket 30
# (284fcc0), which lost it in the merge.
#
# In ticket 30 it backed `get-config` for a configuration whose file was short —
# create-config wrote only SUBVOLUME and FSTYPE and get-config supplied the rest.
# The merged fake does not have that shape: `default_config` above writes the
# whole set, so the file is never short. It is kept, and kept wired to
# `set-config`'s floor rather than deleted, for the reason the union lost: one
# definition of "the canonical set" is what stops the mutator's write and soil's
# converge from being two literals that drift apart. `default_config` is the
# distribution's template and is deliberately a *different* set.
canonical_config() {
    local key value
    for pair in \
        'SUBVOLUME=/var/lib/guarden' \
        'FSTYPE=btrfs' \
        'EMPTY_PRE_POST_CLEANUP=no' \
        'NUMBER_MIN_AGE=3600' \
        'NUMBER_CLEANUP=yes' \
        'TIMELINE_CLEANUP=yes' \
        'TIMELINE_LIMIT_HOURLY=0' \
        'TIMELINE_LIMIT_DAILY=0-7' \
        'TIMELINE_LIMIT_WEEKLY=0-4' \
        'TIMELINE_LIMIT_MONTHLY=0-6' \
        'TIMELINE_LIMIT_QUARTERLY=0-2' \
        'TIMELINE_LIMIT_YEARLY=0' \
        'NUMBER_LIMIT=2-10' \
        'NUMBER_LIMIT_IMPORTANT=8-12' \
        'FREE_LIMIT=0.10'
    do
        key=${pair%%=*}
        value=${pair#*=}
        printf '%s=%s\n' "$key" "$value"
    done
}

# A configuration exists once any of its three traces does: a stored
# configuration, a snapshot list, or a create. Snapshots for a configuration
# that does not exist are not a thing, and a `.list` seed is how a test writes
# one.
config_exists() {
    [ -f "$conf_file" ] || [ -f "$list_file" ] || [ -f "$GUARDEN_FAKE_SNAPPER/$config.created" ]
}

ensure_config() {
    config_exists || return 1
    [ -f "$conf_file" ] || default_config
    return 0
}

json_escape() {
    local text=$1
    text=${text//\\/\\\\}
    text=${text//\"/\\\"}
    printf '%s' "$text"
}

# userdata_json <k=v,k=v>: the map as a real JSON object, so `important` is a key.
userdata_json() {
    local pairs=$1 pair key value
    printf '{'
    local first=1
    local rest=$pairs
    while [ -n "$rest" ]; do
        pair=${rest%%,*}
        if [ "$pair" = "$rest" ]; then
            rest=
        else
            rest=${rest#*,}
        fi
        [ -n "$pair" ] || continue
        key=${pair%%=*}
        value=${pair#*=}
        # snapper parses `important=yes, guarden=x` into a map, so the space
        # after the comma is a separator and not part of the key.
        key=${key## }
        key=${key# }
        value=${value# }
        value=${value% }
        [ "$first" = 1 ] || printf ','
        first=0
        printf '"%s":"%s"' "$(json_escape "$key")" "$(json_escape "$value")"
    done
    printf '}'
}

list_json() {
    local line number cleanup date description userdata
    printf '['
    local first=1
    if [ -f "$list_file" ]; then
        while IFS='|' read -r number cleanup date description userdata; do
            [ -n "${number:-}" ] || continue
            [ "$first" = 1 ] || printf ','
            first=0
            printf '{"number":%s,"date":"%s","description":"%s","cleanup":"%s","tags":["%s"],"userdata":%s}' \
                "$number" "$(json_escape "$date")" "$(json_escape "$description")" \
                "$cleanup" "$cleanup" "$(userdata_json "$userdata")"
        done <"$list_file"
    fi
    printf ']'
}

# The rendering CSV produces, and the reason guarden does not read it: the whole
# userdata map is one comma-joined quoted field, so a consumer string-matches.
list_csv() {
    local line number cleanup date description userdata
    printf '#|number|date|user_used|cleanup|description|userdata\n'
    if [ -f "$list_file" ]; then
        while IFS='|' read -r number cleanup date description userdata; do
            [ -n "${number:-}" ] || continue
            printf '%s|%s|%s|0|%s|%s|"%s"\n' \
                "$number" "$number" "$date" "$cleanup" "$description" "$userdata"
        done <"$list_file"
    fi
}

list_table() {
    local number cleanup date description userdata
    printf '%-7s %-12s %-20s %s\n' "number" "cleanup" "date" "description"
    if [ -f "$list_file" ]; then
        while IFS='|' read -r number cleanup date description userdata; do
            [ -n "${number:-}" ] || continue
            printf '%-7s %-12s %-20s %s\n' "$number" "$cleanup" "$date" "$description"
        done <"$list_file"
    fi
}

case "$verb" in
    list)        case "$format" in
            json) list_json ;;
            csv) list_csv ;;
            table) list_table ;;
            *) fake_die "unknown --machine-readable format: $format" ;;
        esac
        ;;
    get-config)
        if [ "${#records[@]}" -gt 1 ]; then
            fake_die "get-config takes at most one key"
        fi
        key=${records[0]:-}
        # A configuration that does not exist is an error, and that is the whole
        # reason soil asks this question rather than statting the path: the
        # effective configuration is read with get-config and never by parsing
        # /etc/snapper/configs/<name>.
        if ! ensure_config; then
            printf 'error: snapper: no configuration for %s\n' "$config" >&2
            exit 1
        fi
        if [ -n "$key" ]; then
            grep "^$key=" "$conf_file" || {
                printf 'error: snapper: no such key: %s\n' "$key" >&2
                exit 1
            }
            exit 0
        fi
        # A configuration the mutator created but has not yet converged carries
        # only what create-config wrote, and answers every other question from
        # the canonical set. This is ticket 30's `canonical_config`, restored:
        # a create that has not been followed by a converge still reports the
        # effective value rather than a hole. The file is not rewritten — this is
        # the read-back reporting, not a converge.
        #
        # "Created but not converged" is a recorded fact, not a guess from the
        # line count: the `.created` marker is written by create-config and a
        # config a test seeded by hand never has one, so a seeded short config
        # still reads back exactly what the test put in it.
        if [ -f "$GUARDEN_FAKE_SNAPPER/$config.created" ] \
            && [ "$(wc -l <"$conf_file")" -lt 15 ]; then
            canonical_config
            exit 0
        fi
        cat "$conf_file"
        ;;
    create-config)
        # The mutator creates a service's configuration and sets its value set
        # here; soil storage converges the same values later. Modelling both is
        # what lets a test tell "the mutator wrote the canonical set" from "soil
        # storage did", which is the difference between a correct create and a
        # correct apply.
        #
        # The subvolume is read from whichever form the caller used: `-p <path>`
        # (soil) or a bare positional (weedr). Both are real snapper, and the
        # default template below records it as SUBVOLUME, so the two forms have
        # to agree on one value here rather than one of them losing it.
        subvol=${subvolume:-${records[0]:-}}
        [ -n "$subvol" ] || fake_die "create-config needs a subvolume"
        [ -d "$subvol" ] || fake_die "create-config: $subvol is not a subvolume"
        [ -e "$conf_file" ] && fake_die "config $config already exists"
        printf '%s\n' "$config" >"$GUARDEN_FAKE_SNAPPER/$config.created"
        subvolume=$subvol
        default_config
        ;;
    set-config)
        [ -f "$conf_file" ] || fake_die "no configuration $config"
        [ "${#settings[@]}" -ge 1 ] || fake_die "set-config needs a KEY=VALUE"
        for setting in "${settings[@]}"; do
            case "$setting" in
                *=*) ;;
                *) fake_die "set-config: $setting is not KEY=VALUE" ;;
            esac
            key=${setting%%=*}
            value=${setting#*=}
            grep -v "^$key=" "$conf_file" >"$conf_file.tmp" || true
            printf '%s=%s\n' "$key" "$value" >>"$conf_file.tmp"
            mv "$conf_file.tmp" "$conf_file"
        done
        ;;
    modify)
        if [ -n "$merge_from" ]; then
            [ -f "$merge_from" ] || fake_die "modify -f: no such file: $merge_from"
            # Merges into the configuration itself, which is the file
            # `get-config` reads. Writing the merge anywhere else — and an
            # earlier revision wrote it to $GUARDEN_FAKE_SNAPPER/<config>.conf
            # — makes a converge that really happened look like drift, because
            # the read-back is looking at a file nothing wrote.
            target="$conf_file"
            touch "$target"
            while IFS= read -r line; do
                case "$line" in
                    ''|'#'*) continue ;;
                esac
                key=${line%%=*}
                grep -v "^$key=" "$target" >"$target.merged" || true
                printf '%s\n' "$line" >>"$target.merged"
                mv "$target.merged" "$target"
            done <"$merge_from"
            exit 0
        fi
        [ "${#records[@]}" -eq 1 ] || fake_die "modify takes exactly one snapshot number"
        [ -n "$algorithm" ] || fake_die "modify needs --cleanup-algorithm"
        printf '%s|%s|%s\n' "${records[0]}" "$algorithm" "$userdata" \
            >>"$GUARDEN_FAKE_SNAPPER/$config.modifications"
        ;;
    *)
        fake_die "unknown command: ${verb:-<none>}"
        ;;
esac
