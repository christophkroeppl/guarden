#!/usr/bin/env bash
# ip — answers `-4 route show default`, which is where the ingress interface and
# the address ingress.alias is derived from both come from.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "ip (guarden fake) 1.0"
        exit 0
        ;;
esac

route="$GUARDEN_FAKE_DIR/ip-route"
[ -f "$route" ] || printf '%s\n' 'default via 192.0.2.1 dev eth0 proto dhcp src 198.51.100.7 metric 100' >"$route"

case "$*" in
    *route*show*default*) cat "$route" ;;
    *) fake_die "ip: only \`-4 route show default\` is modelled" ;;
esac
