#!/usr/bin/env bash
# chown — records the call and changes nothing.
#
# Ownership is recorded rather than applied: the fast harness runs unprivileged
# and cannot chown to root, so applying it would be a permission error rather
# than an install. `assert_owner` is how the fast harness checks a mode, and the
# owner of a root-owned path is what the golden VM proves.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "chown (guarden fake) 1.0"
        exit 0
        ;;
esac

exit 0
