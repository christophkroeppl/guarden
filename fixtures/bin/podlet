#!/usr/bin/env bash
# The `podlet` fake: the Compose-to-quadlet converter loom drives.
#
# The model is in ../lib/podlet.py and it is a **pass-through translator with no
# opinion**, which is the point. A converter that passed `PublishPort=`,
# `Network=host` or `PodmanArgs=` through is not a security boundary, and loom
# has to be one instead (spec 4, 6.3) — so this fake is deliberately the kind of
# converter that passes them all through, and the tests that assert none of them
# survives into the installed unit are testing loom, not this.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"
fake_early_exit "$@"

here=$(dirname "$(readlink -f "$0")")
exec python3 "$here/../lib/podlet.py" "$@"
