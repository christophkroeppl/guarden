#!/usr/bin/env bash
# btrfs — answers `subvolume list /`, which is how soil verifies the layout
# rather than converting it. The default is a converted host, so the check has
# to be made to fail deliberately to be worth anything.
# btrfs — a subvolume per volume, and never a plain directory.
#
# The distinction matters: a nested subvolume is excluded from its parent's
# snapshot entirely, so a bulk volume created as a directory would be a mount of
# something else after a fork (spec 8.1, and the instance layout in spec 2).
. "$(dirname "$0")/../lib/fake.sh"
. "$(dirname "$0")/../lib/users.sh"

fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "btrfs (guarden fake) 1.0"
        exit 0
        ;;
esac

layout="$GUARDEN_FAKE_DIR/btrfs-subvolumes"
mkdir -p "$GUARDEN_FAKE_DIR"
[ -f "$layout" ] || printf '%s\n' \
    'ID 256 gen 42 top level 5 path @' \
    'ID 257 gen 42 top level 5 path @var' >"$layout"

fake_early_exit "$@"

# Both tickets extended this fake and the union left two dispatchers in one
# file, so order is load-bearing: whichever comes first wins, and the other
# becomes unreachable. `list` is soil's (it verifies the layout rather than
# converting it) and `create` is weedr's (a subvolume per volume, never a plain
# directory — a nested subvolume is excluded from its parent's snapshot
# entirely, so a bulk volume created as a directory would be a mount of
# something else after a fork, spec 8.1). Both are real, so both are answered
# here and each returns rather than falling through to the other's arm.
[ "${1:-}" = "subvolume" ] || fake_die "unknown command ${1:-<none>}"

case "${2:-}" in
    list)
        cat "$layout"
        exit 0
        ;;
    create)
        target=${3:-}
        [ -n "$target" ] || fake_die "subvolume create needs a path"
        [ -d "$(dirname "$target")" ] || fake_die "the parent of $target does not exist"
        mkdir -p "$target"
        mkdir -p "$GUARDEN_FIXTURES/subvolumes"
        : >"$GUARDEN_FIXTURES/subvolumes/$(printf '%s' "$target" | tr '/' '_')"
        exit 0
        ;;
    *)
        fake_die "unknown subcommand ${2:-<none>}"
        ;;
esac
