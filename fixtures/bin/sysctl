#!/usr/bin/env bash
# sysctl — answers `-n <key>` with a kernel-ish value and remembers `-w`.
#
# The threshold's default is the kernel's own 1024, because the invariant
# `soil` owns is the value 1024 and not "whatever the distribution ships": a
# host that ships 0 is the case the check exists for, and a fake that shipped 0
# by default would make that untestable.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "sysctl (guarden fake) 1.0"
        exit 0
        ;;
esac

state="$GUARDEN_FAKE_DIR/sysctl.state"

[ -f "$state" ] || printf '%s\n' \
    'net.ipv4.ip_unprivileged_port_start=1024' \
    'net.ipv6.conf.all.disable_ipv6=0' \
    'net.ipv6.conf.default.disable_ipv6=0' >"$state"

set_value() {
    key=$1
    value=$2
    grep -v "^$key=" "$state" >"$state.new"
    printf '%s=%s\n' "$key" "$value" >>"$state.new"
    mv "$state.new" "$state"
}

get_value() {
    line=$(grep "^$1=" "$state")
    if [ -n "$line" ]; then
        printf '%s\n' "${line#*=}"
        return 0
    fi
    # A key nobody has written answers the kernel's own default. route_localnet
    # is per interface and 0 everywhere, which is the state before soil runs.
    case "$1" in
        net.ipv4.conf.*.route_localnet) printf '0\n' ;;
        net.ipv6.conf.*.disable_ipv6) printf '0\n' ;;
        *) fake_die "unknown sysctl key: $1" ;;
    esac
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -n) [ "$#" -ge 2 ] || fake_die "-n needs a key"; get_value "$2"; exit $? ;;
        -w)
            [ "$#" -ge 2 ] || fake_die "-w needs an assignment"
            set_value "${2%%=*}" "${2#*=}"
            exit 0
            ;;
        -*) fake_die "unknown option $1" ;;
        *) fake_die "unknown command: $1" ;;
    esac
done
fake_die "sysctl: nothing to do"
