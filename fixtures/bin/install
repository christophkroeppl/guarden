#!/usr/bin/env bash
# install — really creates and copies, because soil's `--check` reads the file
# back and a fake that only logged would make every phase look converged.
#
# Ownership is recorded and not applied: a test run cannot chown to root, and
# the owner of a path guarden owns is what the golden VM proves.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "install (guarden fake) 1.0"
        exit 0
        ;;
esac

mode=0755
mode_given=0
directory=0
operands=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        -d) directory=1; shift ;;
        -m) mode=$2; mode_given=1; shift 2 ;;
        -o|-g) shift 2 ;;
        -*) shift ;;
        *) operands+=("$1"); shift ;;
    esac
done

[ "${#operands[@]}" -ge 1 ] || fake_die "install: no path"

if [ "$directory" = 1 ]; then
    mkdir -p "${operands[0]}"
    [ "$mode_given" = 1 ] && chmod "$mode" "${operands[0]}"
    exit 0
fi

[ "${#operands[@]}" -ge 2 ] || fake_die "install: copying needs a source and a target"

if [ "${#operands[@]}" = 2 ]; then
    # `install a b` is a file rename, and `install a somedir` is a copy into it.
    if [ -d "${operands[1]}" ]; then
        cp "${operands[0]}" "${operands[1]}/"
    else
        cp "${operands[0]}" "${operands[1]}"
        [ "$mode_given" = 1 ] && chmod "$mode" "${operands[1]}"
    fi
    exit 0
fi

target=${operands[${#operands[@]} - 1]}
index=0
while [ "$index" -lt $((${#operands[@]} - 1)) ]; do
    cp "${operands[$index]}" "$target/"
    index=$((index + 1))
done
