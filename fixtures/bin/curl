#!/usr/bin/env bash
# curl — the one fetch from outside a distribution repository, so it is the fake
# that matters most for the SHA256 pin. It serves a seeded body so a test can
# both satisfy the pin and break it.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "curl (guarden fake) 1.0"
        exit 0
        ;;
esac

output=""
url=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output) output=$2; shift 2 ;;
        -*) shift ;;
        *) url=$1; shift ;;
    esac
done
[ -n "$output" ] || fake_die "curl: no --output given"
[ -n "$url" ] || fake_die "curl: no url given"

body="$GUARDEN_FAKE_DIR/curl-body"
mkdir -p "$(dirname "$output")"
if [ -f "$body" ]; then
    cp "$body" "$output"
else
    : >"$output"
fi
