#!/usr/bin/env bash
# systemctl — answers `is-enabled` and `is-active` and remembers `enable`,
# `disable`, `start` and `stop`, because a converger that cannot ask whether a
# unit is already disabled is not idempotent: it would re-disable on every run
# and a second apply would look like a change.
. "$(dirname "$0")/../lib/fake.sh"
fake_init "$@"

case "${1:-}" in
    --version|-V)
        printf '%s\n' "systemctl (guarden fake) 1.0"
        exit 0
        ;;
esac

units="$GUARDEN_FAKE_DIR/systemd"
mkdir -p "$units"

record() {
    key=$1
    unit=$2
    printf '%s\n' "$3" >"$units/$unit.$key"
}

read_state() {
    key=$1
    unit=$2
    if [ -f "$units/$unit.$key" ]; then
        cat "$units/$unit.$key"
        return 0
    fi
    # A unit nothing has been asked about is disabled and inactive, because a
    # timer that was never enabled is not running and pretending otherwise would
    # make every converger think it had already done its work.
    case "$key" in
        enabled) printf 'disabled\n' ;;
        *) printf 'inactive\n' ;;
    esac
}

command_name=''
now=0
operands=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --now|-q|--quiet|--no-pager) [ "$1" = --now ] && now=1; shift ;;
        is-enabled|is-active|enable|disable|start|stop|restart|daemon-reload)
            [ -z "$command_name" ] && command_name=$1
            shift
            ;;
        -*) shift ;;
        *) operands+=("$1"); shift ;;
    esac
done

case "$command_name" in
    is-enabled)
        for unit in "${operands[@]}"; do
            printf '%s\n' "$(read_state enabled "$unit")"
        done
        exit 0
        ;;
    is-active)
        for unit in "${operands[@]}"; do
            printf '%s\n' "$(read_state active "$unit")"
        done
        exit 0
        ;;
    enable|disable)
        for unit in "${operands[@]}"; do
            if [ "$command_name" = enable ]; then
                record enabled "$unit" enabled
                [ "$now" = 1 ] && record active "$unit" active
            else
                record enabled "$unit" disabled
                [ "$now" = 1 ] && record active "$unit" inactive
            fi
        done
        exit 0
        ;;
    start|stop|restart)
        for unit in "${operands[@]}"; do
            if [ "$command_name" = stop ]; then
                record active "$unit" inactive
            else
                record active "$unit" active
            fi
        done
        exit 0
        ;;
    '')
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
