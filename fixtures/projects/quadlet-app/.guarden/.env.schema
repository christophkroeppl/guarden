// The shape of this service's credentials. Names, types and examples; never a
// value, and there is no `.env.example` to keep in step with.
//
// `@defaultSensitive=false` and `@defaultRequired=infer` are spelled out here so
// that the fixture exercises both decorators rather than only the defaults:
// without them every key would be a required credential and the `type=env` line
// below would be the only interesting thing in the file.

// @defaultSensitive=false
// @defaultRequired=infer

// DB_PASSWORD=EXAMPLE-not-a-real-password
//   @required
//   @sensitive
//   @example EXAMPLE-not-a-real-password

// SESSION_SIGNING_KEY
//   @sensitive
//   @type env

// LOG_LEVEL=info
