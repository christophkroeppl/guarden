#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
BEDS_DIR="$STATE/beds"
TWIG_DIR="$STATE/twig"
DOMAIN="${GUARDEN_DOMAIN:-example.com}"

usage() {
  cat <<'EOF'
usage: twig [sync] [--help]

twig — the dashboard generator that renders and aggregates dashboard config
from beds.

commands:
  sync    regenerate Homepage config from every bed
EOF
}

cmd_sync() {
  mkdir -p "$TWIG_DIR"
  python3 - "$BEDS_DIR" "$TWIG_DIR" "$DOMAIN" <<'PYEOF'
import os, re, sys

beds_dir, twig_dir, domain = sys.argv[1], sys.argv[2], sys.argv[3]

def parse_meta(path):
    meta = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if "=" in line:
                k, _, v = line.partition("=")
                meta[k] = v
    return meta

def parse_bed_yaml(path):
    repo = None
    with open(path) as f:
        for line in f:
            stripped = line.strip()
            if stripped.startswith("repo:"):
                repo = stripped.split(":", 1)[1].strip().strip("\"'")
    return repo

def parse_widget(path):
    desc = href = icon = None
    with open(path) as f:
        for line in f:
            stripped = line.strip()
            if stripped.startswith("description:"):
                desc = stripped.split(":", 1)[1].strip().strip("\"'")
            elif stripped.startswith("href:"):
                href = stripped.split(":", 1)[1].strip().strip("\"'")
            elif stripped.startswith("icon:"):
                icon = stripped.split(":", 1)[1].strip().strip("\"'")
    return desc, href, icon

def substitute(pattern, env, domain):
    safe = re.sub(r"[:/]", "-", env)
    return pattern.replace("${env}", safe).replace("${domain}", domain)

projects = {}

if os.path.isdir(beds_dir):
    for bed_name in sorted(os.listdir(beds_dir)):
        bed_dir = os.path.join(beds_dir, bed_name)
        if not os.path.isdir(bed_dir):
            continue
        meta_path = os.path.join(bed_dir, "meta")
        if not os.path.isfile(meta_path):
            continue
        meta = parse_meta(meta_path)
        project = meta.get("project", bed_name)
        env = meta.get("env", "staging")
        repo = None
        bed_yaml = os.path.join(bed_dir, "bed.yaml")
        if os.path.isfile(bed_yaml):
            repo = parse_bed_yaml(bed_yaml)
        if project not in projects:
            projects[project] = {"services": {}, "repo": None}
        if repo and not projects[project]["repo"]:
            projects[project]["repo"] = repo
        widgets_dir = os.path.join(bed_dir, "widgets")
        if os.path.isdir(widgets_dir):
            for fname in sorted(os.listdir(widgets_dir)):
                if not fname.endswith(".yml"):
                    continue
                svc_name = fname[:-4]
                if svc_name in projects[project]["services"]:
                    continue
                desc, href, icon = parse_widget(os.path.join(widgets_dir, fname))
                if href:
                    href = substitute(href, env, domain)
                projects[project]["services"][svc_name] = {
                    "description": desc,
                    "href": href,
                    "icon": icon,
                }

out_path = os.path.join(twig_dir, "services.yaml")
lines = []
for project in sorted(projects):
    lines.append("- %s:" % project)
    data = projects[project]
    for svc_name in sorted(data["services"]):
        svc = data["services"][svc_name]
        lines.append("    - %s:" % svc_name)
        if svc["description"]:
            lines.append("        description: %s" % svc["description"])
        if svc["href"]:
            lines.append("        href: %s" % svc["href"])
        if svc["icon"]:
            lines.append("        icon: %s" % svc["icon"])
    lines.append("    - Staging:")
    lines.append("        href: https://staging.%s" % domain)
    if data["repo"]:
        lines.append("    - Repo:")
        lines.append("        href: %s" % data["repo"])

if lines:
    with open(out_path, "w") as f:
        f.write("\n".join(lines) + "\n")
else:
    if os.path.isfile(out_path):
        os.remove(out_path)
PYEOF
  echo "twig: Homepage config written to $TWIG_DIR/services.yaml"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  sync)
    cmd_sync
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
