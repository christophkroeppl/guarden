#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
BEDS_DIR="$STATE/beds"
TWIG_DIR="$STATE/twig"
DOMAIN="${GUARDEN_DOMAIN:-example.com}"

usage() {
  cat <<'EOF'
usage: twig [sync] [--help]

twig — the dashboard generator that renders and aggregates dashboard config
from beds.

commands:
  sync    regenerate Homepage config from every bed
EOF
}

cmd_sync() {
  mkdir -p "$TWIG_DIR"
  python3 - "$BEDS_DIR" "$TWIG_DIR" "$DOMAIN" <<'PYEOF'
import os, sys

beds_dir, twig_dir, domain = sys.argv[1], sys.argv[2], sys.argv[3]

ENVS = ("production", "staging", "preview", "fence")

def parse_bed_yaml(path):
    env = None
    repo = None
    with open(path) as f:
        for line in f:
            raw = line.rstrip("\n")
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if len(raw) != len(raw.lstrip()):
                continue
            if stripped.startswith("environment:"):
                env = stripped.split(":", 1)[1].strip().strip("\"'")
            elif stripped.startswith("repo:"):
                repo = stripped.split(":", 1)[1].strip().strip("\"'")
    if env is not None and env not in ENVS:
        env = None
    return env, repo

def bed_id_parts(bed_name):
    parts = bed_name.split("-")
    if len(parts) >= 3 and parts[0] == "bed" and parts[1] in ENVS:
        return parts[1], "-".join(parts[2:])
    return None, None

def parse_widget(path):
    desc = href = icon = None
    with open(path) as f:
        for line in f:
            stripped = line.strip()
            if stripped.startswith("description:"):
                desc = stripped.split(":", 1)[1].strip().strip("\"'")
            elif stripped.startswith("href:"):
                href = stripped.split(":", 1)[1].strip().strip("\"'")
            elif stripped.startswith("icon:"):
                icon = stripped.split(":", 1)[1].strip().strip("\"'")
    return desc, href, icon

def substitute(pattern, env):
    return pattern.replace("${env}", env).replace("${domain}", domain)

def write_if_changed(path, text):
    if os.path.isfile(path):
        with open(path) as f:
            if f.read() == text:
                return
    with open(path, "w") as f:
        f.write(text)

entries = []
if os.path.isdir(beds_dir):
    for bed_name in sorted(os.listdir(beds_dir)):
        bed_dir = os.path.join(beds_dir, bed_name)
        if not os.path.isdir(bed_dir):
            continue
        yaml_env = None
        repo = None
        bed_yaml = os.path.join(bed_dir, ".guarden", "bed.yaml")
        if os.path.isfile(bed_yaml):
            yaml_env, repo = parse_bed_yaml(bed_yaml)
        id_env, project = bed_id_parts(bed_name)
        env = yaml_env or id_env
        if not env or not project:
            continue
        entries.append((0 if env == "production" else 1, bed_name, bed_dir, env, project, repo))
entries.sort()

projects = {}
for _prio, _bed_name, bed_dir, env, project, repo in entries:
    if project not in projects:
        projects[project] = {"services": {}, "repo": None}
    if repo and not projects[project]["repo"]:
        projects[project]["repo"] = repo
    widgets_dir = os.path.join(bed_dir, ".guarden", "widgets")
    if not os.path.isdir(widgets_dir):
        continue
    for fname in sorted(os.listdir(widgets_dir)):
        if not fname.endswith(".yml"):
            continue
        svc_name = fname[:-4]
        if svc_name in projects[project]["services"]:
            continue
        desc, href, icon = parse_widget(os.path.join(widgets_dir, fname))
        if href:
            href = substitute(href, env)
        projects[project]["services"][svc_name] = {
            "description": desc,
            "href": href,
            "icon": icon,
        }

lines = []
for project in sorted(projects):
    lines.append("- %s:" % project)
    data = projects[project]
    for svc_name in sorted(data["services"]):
        svc = data["services"][svc_name]
        lines.append("    - %s:" % svc_name)
        if svc["description"]:
            lines.append("        description: %s" % svc["description"])
        if svc["href"]:
            lines.append("        href: %s" % svc["href"])
        if svc["icon"]:
            lines.append("        icon: %s" % svc["icon"])
    lines.append("    - Staging:")
    lines.append("        href: https://staging.%s" % domain)
    if data["repo"]:
        lines.append("    - Repo:")
        lines.append("        href: %s" % data["repo"])

out_path = os.path.join(twig_dir, "services.yaml")
if lines:
    write_if_changed(out_path, "\n".join(lines) + "\n")
else:
    if os.path.isfile(out_path):
        os.remove(out_path)
PYEOF
  echo "twig: Homepage config written to $TWIG_DIR/services.yaml"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  sync)
    cmd_sync
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
