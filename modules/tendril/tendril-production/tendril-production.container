[Unit]
Description=Cloudflare Tunnel for tendril-production
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/lib/guarden/bin/cloudflared tunnel --config /etc/guarden/tendril-production/config.yml run
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/secrets
ReadWritePaths=/etc/guarden/tendril-production

# Credentials — the renderer names the secret; podman resolves it from this
# service's own secret store. No LoadCredentialEncrypted= here: this unit runs
# in the service user's manager, which cannot read the system host key.
Secret=TUNNEL_CREDENTIAL,type=file

[Install]
WantedBy=default.target