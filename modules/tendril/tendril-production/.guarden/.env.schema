# The tunnel service's credential schema.
#
# The tunnel's own credential lands as a file at /run/secrets/TUNNEL_CREDENTIAL
# and is named as credentials-file: in the rendered cloudflared config.
# The Cloudflare API token is stored separately at /etc/guarden/share.api-token
# (0600 root) and is read by the mutator directly — never rendered into a unit.

# Tunnel credential from Cloudflare (file-based, presented at /run/secrets/TUNNEL_CREDENTIAL)
TUNNEL_CREDENTIAL
@required true
@sensitive true
@type file
@example EXAMPLE-TUNNEL-CREDENTIAL