[Unit]
Description=the edge

[Container]
Image=docker.io/library/traefik:v3.2
Exec=--providers.file.directory=/etc/guarden/edge
Exec=--providers.file.watch=true
Exec=--entryPoints.web.address=:80
Exec=--entryPoints.web.http.redirections.entrypoint.to=websecure
Exec=--entryPoints.websecure.address=:443
Exec=--entryPoints.websecure.http3
Exec=--entryPoints.api.address=:8080
Exec=--entryPoints.api.http.api=true
Exec=--entryPoints.api.http.api.dashboard=true
Exec=--entryPoints.api.http.api.insecure=true
Exec=--accesslog=true
Exec=--log.level=INFO
Volume=/var/lib/guarden/edge/dynamic:/etc/guarden/edge:ro