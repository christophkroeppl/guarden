[Unit]
Description=the edge

[Container]
Image=docker.io/library/traefik:v3.2
Exec=--providers.file.directory=/etc/guarden/edge --providers.file.watch=true --entrypoints.web.address=:80 --entrypoints.web.http.redirections.entrypoint.to=websecure --entrypoints.websecure.address=:443 --entrypoints.websecure.http3 --entrypoints.api.address=:8080 --entrypoints.api.http.api=true --entrypoints.api.http.api.dashboard=true --entrypoints.api.http.api.insecure=true --accesslog=true --log.level=INFO
Volume=/var/lib/guarden/edge/dynamic:/etc/guarden/edge:ro