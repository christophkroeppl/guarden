#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
PINS_DIR="$STATE/stakes"
PINS_FILE="$PINS_DIR/pins"

usage() {
  cat <<'EOF'
usage: stakes <command>

stakes — standalone pin registry. Holds snapshot pins so ladders cannot prune
pinned data. A pin is a snapshot id with the holder bed identities that keep
it; state lives in one root-readable file, no long-lived daemon.

commands:
  pin <snapshot> --holder <bed>    hold a snapshot for a bed
  unpin <snapshot> --holder <bed>  release a hold; frees the pin at the last holder
  query [snapshot]                 print holders=N and the holder ids
  list                             every ladder and its pins
EOF
}

parse_pin_args() {
  snapshot=""
  holder=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --holder) holder="${2:-}"; shift 2 ;;
      -*) echo "stakes: unknown option: $1" >&2; exit 2 ;;
      *) snapshot="$1"; shift ;;
    esac
  done
}

holders_of() {
  local id="$1"
  [ -f "$PINS_FILE" ] || { echo 0; return; }
  awk -v id="$id" '$1 == id { for (i = 2; i <= NF; i++) if (!seen[$i]++) n++ } END { print n + 0 }' "$PINS_FILE"
}

holders_line() {
  local id="$1"
  [ -f "$PINS_FILE" ] || { echo "holders=0"; return; }
  local sorted h n=0 rest=""
  sorted="$(awk -v id="$id" '$1 == id { for (i = 2; i <= NF; i++) print $i }' "$PINS_FILE" | sort -u)"
  [ -n "$sorted" ] || { echo "holders=0"; return; }
  while IFS= read -r h; do
    n=$((n + 1))
    rest="$rest $h"
  done <<< "$sorted"
  echo "holders=$n$rest"
}

ensure_pins() {
  mkdir -p "$PINS_DIR"
  touch "$PINS_FILE"
  chmod 600 "$PINS_FILE"
}

cmd_pin() {
  shift
  parse_pin_args "$@"
  if [ -z "$snapshot" ] || [ -z "$holder" ]; then
    echo "stakes pin: requires <snapshot> and --holder <bed>" >&2
    exit 2
  fi
  ensure_pins
  exec 9>"$PINS_DIR/pins.lock"
  flock 9
  local tmp line lid found=0
  tmp="$(mktemp "$PINS_DIR/.pins.XXXXXX")"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    lid="${line%% *}"
    if [ "$lid" = "$snapshot" ]; then
      found=1
      case " $line " in
        *" $holder "*) printf '%s\n' "$line" >> "$tmp" ;;
        *) printf '%s %s\n' "$line" "$holder" >> "$tmp" ;;
      esac
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$PINS_FILE"
  if [ "$found" -eq 0 ]; then
    printf '%s %s\n' "$snapshot" "$holder" >> "$tmp"
  fi
  mv "$tmp" "$PINS_FILE"
  chmod 600 "$PINS_FILE"
  echo "pinned $snapshot holder=$holder holders=$(holders_of "$snapshot")"
}

cmd_unpin() {
  shift
  parse_pin_args "$@"
  if [ -z "$snapshot" ] || [ -z "$holder" ]; then
    echo "stakes unpin: requires <snapshot> and --holder <bed>" >&2
    exit 2
  fi
  ensure_pins
  exec 9>"$PINS_DIR/pins.lock"
  flock 9
  local tmp line lid rest h out
  tmp="$(mktemp "$PINS_DIR/.pins.XXXXXX")"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    lid="${line%% *}"
    if [ "$lid" = "$snapshot" ]; then
      rest="${line#"$lid"}"
      out="$lid"
      for h in $rest; do
        if [ "$h" != "$holder" ]; then
          out="$out $h"
        fi
      done
      if [ "$out" != "$lid" ]; then
        printf '%s\n' "$out" >> "$tmp"
      fi
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$PINS_FILE"
  mv "$tmp" "$PINS_FILE"
  chmod 600 "$PINS_FILE"
  echo "unpinned $snapshot holder=$holder holders=$(holders_of "$snapshot")"
}

cmd_query() {
  shift
  local snapshot="${1:-}"
  if [ -n "$snapshot" ]; then
    holders_line "$snapshot"
    return 0
  fi
  [ -f "$PINS_FILE" ] || return 0
  local line lid
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    lid="${line%% *}"
    echo "$lid $(holders_line "$lid")"
  done < "$PINS_FILE"
}

cmd_list() {
  local sysroot="${GUARDEN_SYSROOT:-}"
  local cfgdir="$sysroot/etc/snapper/configs"
  local f name
  if [ -d "$cfgdir" ]; then
    for f in "$cfgdir"/*; do
      [ -e "$f" ] || continue
      name="${f##*/}"
      echo "ladder $name"
    done
  fi
  [ -f "$PINS_FILE" ] || return 0
  local line lid
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    lid="${line%% *}"
    echo "pin $lid $(holders_line "$lid")"
  done < "$PINS_FILE"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  pin)
    cmd_pin "$@"
    ;;
  unpin)
    cmd_unpin "$@"
    ;;
  query)
    cmd_query "$@"
    ;;
  list)
    cmd_list "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
