#!/usr/bin/env bash
# The golden-VM runner entry point.
#
# The golden VM is the harness that cannot be faked: a throwaway machine with
# real tools, proving that a rootless container reaches a dependency by the
# pinned alias (ADR-0018), that nothing unprivileged binds below 1024, that a
# forwarded port answers from a second machine, and that a clone of a live data
# volume starts and recovers. Minutes, manual or nightly (spec 11).
#
# This is the entry point and nothing else: it resolves a target, resolves the
# cloud-init user-data, and prints or runs the command sequence. What the run
# asserts is tickets 15, 20, 30 and 140's work, and this script does not assert
# any of it — a runner that also decided what a pass was would be a harness
# whose result nobody could audit.
#
#   tools/golden-vm --print                  the plan, and no machine
#   tools/golden-vm --target HOST            boot one and run it
#   GUARDEN_VM_TARGET=HOST tools/golden-vm   the same, from the environment

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")

target=${GUARDEN_VM_TARGET:-}
# The user-data is rendered from `packages/packages.toml` rather than read from a
# file that can go stale, because a document whose packages were copied by hand
# is a second copy of the list and a package added to one is not installed on the
# machine the ticket's claims are proven on. `tools/cloud-init/user-data.yaml`
# is the rendered artefact and is committed for a human to read; regenerating it
# is `--render` and happens here, so what is passed is what the list says today.
user_data="$root/tools/cloud-init/user-data.yaml"
family=""
print_only=0
remote=root
connect_timeout=10

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --target)
            [ "$#" -ge 2 ] || die "--target needs a host"
            target=$2
            shift 2
            ;;
        --user-data)
            [ "$#" -ge 2 ] || die "--user-data needs a path"
            user_data=$2
            shift 2
            ;;
        --remote)
            [ "$#" -ge 2 ] || die "--remote needs a user"
            remote=$2
            shift 2
            ;;
        --connect-timeout)
            [ "$#" -ge 2 ] || die "--connect-timeout needs seconds"
            connect_timeout=$2
            shift 2
            ;;
        --family)
            [ "$#" -ge 2 ] || die "--family needs a distribution family"
            family=$2
            shift 2
            ;;
        --print)
            print_only=1
            shift
            ;;
        --help)
            printf 'usage: golden-vm [--target HOST] [--user-data PATH] [--remote USER]\n'
            printf '                 [--family NAME] [--connect-timeout SECONDS] [--print]\n'
            printf '\n'
            printf 'The user-data is rendered from packages/packages.toml before it is passed,\n'
            printf 'unless --user-data names a file to use as given.\n'
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

# The soil phases, in the order spec 6.1 gives them. Read from the program
# rather than kept here, so the runner and the phase list cannot drift.
phases=$(PYTHONPATH="$root/src" python3 -m guarden.soil list | cut -d' ' -f1)
phases_line=$(printf '%s' "$phases" | tr '\n' ' ')

# The command the machine runs: converge every phase, then report drift for
# every phase. A run that ends with drift is a run that failed.
sequence=""
for phase in $phases; do
    sequence="$sequence soil $phase --apply;"
done
for phase in $phases; do
    sequence="$sequence soil $phase --check;"
done
sequence="${sequence%;}"

# The document is rendered from `packages/packages.toml` and checked against the
# committed one, and the committed path is what is passed. Both halves matter:
# passing a temporary render would mean the file a reviewer reads in the
# repository is not the file the machine boots, and passing the committed file
# unchecked would mean a package added to the list and not re-rendered boots a
# machine missing it. So the render is the check and the committed file is the
# artefact, and a stale one is refused with the command that fixes it.
#
# The renderer is silenced on success: this script's own stdout is the plan, and
# AGENTS.md's rule is that a diagnostic is one line. A render that succeeded has
# nothing to say, so its chatter is discarded rather than prefixed.
rendered=$(mktemp)
trap 'rm -f "$rendered"' EXIT
render_args=(--render-user-data "$rendered")
[ -n "$family" ] && render_args+=(--family "$family")

render_output=$(PYTHONPATH="$root/src" python3 -m guarden.soil packages "${render_args[@]}" 2>&1) || {
    printf '%s\n' "$render_output" >&2
    die "the cloud-init user-data could not be rendered from packages/packages.toml"
}

if [ "$user_data" = "$root/tools/cloud-init/user-data.yaml" ]; then
    if ! diff -q "$rendered" "$user_data" >/dev/null 2>&1; then
        die "$user_data is not what packages/packages.toml renders. Re-render it:
     PYTHONPATH=$root/src python3 -m guarden.soil packages \\
         --render-user-data $user_data${family:+ --family $family}"
    fi
else
    [ -f "$user_data" ] || die "the cloud-init user-data is missing: $user_data"
    [ -r "$user_data" ] || die "the cloud-init user-data is not readable: $user_data"
fi

if [ "$print_only" = 1 ]; then
    printf 'user-data  %s\n' "$user_data"
    printf 'phases     %s\n' "$phases_line"
    printf 'sequence   %s\n' "$sequence"
    exit 0
fi

[ -n "$target" ] || die "no target; pass --target HOST or set GUARDEN_VM_TARGET"

printf 'booting %s from %s\n' "$target" "$user_data"
printf 'phases     %s\n' "$phases_line"
printf 'running   %s\n' "$sequence"

scp -q "$user_data" "$remote@$target:/var/tmp/guarden-user-data.yaml"
ssh -o ConnectTimeout="$connect_timeout" "$remote@$target" \
    "cloud-init --file /var/tmp/guarden-user-data.yaml; $sequence"
