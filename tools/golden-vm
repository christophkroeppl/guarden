#!/usr/bin/env bash
# The golden-VM runner entry point.
#
# The golden VM is the harness that cannot be faked: a throwaway machine with
# real tools, proving that a rootless container reaches a dependency by the
# pinned alias (ADR-0018), that nothing unprivileged binds below 1024, that a
# forwarded port answers from a second machine, and that a clone of a live data
# volume starts and recovers. Minutes, manual or nightly (spec 11).
#
# This is the entry point and nothing else: it resolves a target, resolves the
# cloud-init user-data, and prints or runs the command sequence. What the run
# asserts is tickets 15, 20, 30 and 140's work, and this script does not assert
# any of it — a runner that also decided what a pass was would be a harness
# whose result nobody could audit.
#
#   tools/golden-vm --print                  the plan, and no machine
#   tools/golden-vm --target HOST            boot one and run it
#   GUARDEN_VM_TARGET=HOST tools/golden-vm   the same, from the environment

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")

target=${GUARDEN_VM_TARGET:-}
# **The document is rendered at use time and never read from a tracked file.**
#
# It used to default to `tools/cloud-init/user-data.yaml` and refuse to boot when
# a fresh render differed from it. That check existed only because the rendered
# file was tracked, and a tracked render is a second copy of the package list
# that goes stale the moment the list changes: every package added meant a
# regeneration commit whose whole content was a rebuild of a file this tool can
# produce. The template and `packages/packages.toml` are the source of truth and
# this renders from them, so what is booted is current by construction.
#
# `--user-data PATH` still names a file to use as given, which is what a
# fixture and a hand-written document need.
user_data=""
family=""
print_only=0
remote=root
connect_timeout=10

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --target)
            [ "$#" -ge 2 ] || die "--target needs a host"
            target=$2
            shift 2
            ;;
        --user-data)
            [ "$#" -ge 2 ] || die "--user-data needs a path"
            user_data=$2
            shift 2
            ;;
        --remote)
            [ "$#" -ge 2 ] || die "--remote needs a user"
            remote=$2
            shift 2
            ;;
        --connect-timeout)
            [ "$#" -ge 2 ] || die "--connect-timeout needs seconds"
            connect_timeout=$2
            shift 2
            ;;
        --family)
            [ "$#" -ge 2 ] || die "--family needs a distribution family"
            family=$2
            shift 2
            ;;
        --print)
            print_only=1
            shift
            ;;
        --help)
            printf 'usage: golden-vm [--target HOST] [--user-data PATH] [--remote USER]\n'
            printf '                 [--family NAME] [--connect-timeout SECONDS] [--print]\n'
            printf '\n'
            printf 'The user-data is rendered from packages/packages.toml before it is passed,\n'
            printf 'unless --user-data names a file to use as given.\n'
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

# The soil phases, in the order spec 6.1 gives them. Read from the program
# rather than kept here, so the runner and the phase list cannot drift.
phases=$(PYTHONPATH="$root/src" python3 -m guarden.soil list | cut -d' ' -f1)
phases_line=$(printf '%s' "$phases" | tr '\n' ' ')

# **The sequence is the document's, and this script no longer builds one.** It
# used to assemble its own copy of `soil <phase> --apply; ...` and append it to
# the ssh command, so a target that booted from the document converged all six
# phases twice: once in the document's `runcmd`, once from here. The document is
# the one statement of the sequence and this reads it from the same source that
# renders the document, so the plan this prints and the plan the machine runs
# are the same string rather than two that agree by inspection.
sequence=$(PYTHONPATH="$root/src" python3 -c \
    'from guarden import userdata; print(userdata.sequence())')

# **The document is rendered, and the render is the document.** There is no
# committed copy to compare against any more: the template and the package list
# are the source of truth, so a fresh render is current by construction and a
# stale artefact is not a state this can be in.
#
# The renderer is silenced on success: this script's own stdout is the plan, and
# AGENTS.md's rule is that a diagnostic is one line. A render that succeeded has
# nothing to say, so its chatter is discarded rather than prefixed.
rendered=$(mktemp)
trap 'rm -f "$rendered"' EXIT
render_args=(--render-user-data "$rendered" --profile golden-vm)
[ -n "$family" ] && render_args+=(--family "$family")

render_output=$(PYTHONPATH="$root/src" python3 -m guarden.soil packages "${render_args[@]}" 2>&1) || {
    printf '%s\n' "$render_output" >&2
    die "the cloud-init user-data could not be rendered from packages/packages.toml"
}

if [ -n "$user_data" ]; then
    [ -f "$user_data" ] || die "the cloud-init user-data is missing: $user_data"
    [ -r "$user_data" ] || die "the cloud-init user-data is not readable: $user_data"
else
    user_data=$rendered
fi

if [ "$print_only" = 1 ]; then
    printf 'user-data  %s\n' "$user_data"
    printf 'phases     %s\n' "$phases_line"
    printf 'sequence   %s\n' "$sequence"
    exit 0
fi

[ -n "$target" ] || die "no target; pass --target HOST or set GUARDEN_VM_TARGET"

printf 'booting %s from %s\n' "$target" "$user_data"
printf 'phases     %s\n' "$phases_line"
printf 'running   %s\n' "$sequence"

scp -q "$user_data" "$remote@$target:/var/tmp/guarden-user-data.yaml"
# **Validate before applying.** `cloud-init schema` is the real validator and it
# lives on the machine rather than on the host, so this is where a document that
# is not valid cloud-config is caught — before it is applied, not after a boot
# that half-worked.
ssh -o ConnectTimeout="$connect_timeout" "$remote@$target" \
    "cloud-init schema --config-file /var/tmp/guarden-user-data.yaml" \
    || die "the cloud-init user-data is not valid cloud-config"
# Apply the document's `runcmd` on the running target, once.
#
# **`cloud-init --file` is not a command, and this line used to run it.** On
# cloud-init 26.1 the subcommands are init, modules, single, query, features,
# analyze, devel, collect-logs, clean, status and schema; `--file` printed usage
# and exited, so the document was never applied here and the sequence appended
# after it was the only thing that converged. `cc_runcmd` writes the document's
# `runcmd` to a script and `scripts-user` executes it — the pair that actually
# runs it, and the reason the appended copy is gone rather than merely unused.
ssh -o ConnectTimeout="$connect_timeout" "$remote@$target" \
    "cloud-init single --name cc_runcmd --frequency always --file /var/tmp/guarden-user-data.yaml && cloud-init single --name scripts-user --frequency always"
