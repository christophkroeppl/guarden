# Traefik Basic Auth users (htpasswd format).
# Copy to htpasswd and add your users. Generate a line with:
#   docker run --rm httpd:alpine htpasswd -nbB YOUR_USER YOUR_PASSWORD
# Or on the host:
#   apt install apache2-utils
#   htpasswd -nbB user password
# One user per line. Example (replace with your own):
admin:$2y$05$...
