#!/usr/bin/env bash
set -euo pipefail

STATE="${GUARDEN_STATE:-/var/lib/guarden}"
SYSROOT="${GUARDEN_SYSROOT:-}"
BEDS_DIR="$STATE/beds"
DYNAMIC_DIR="$SYSROOT/var/lib/roots/dynamic"
DOMAIN="${GUARDEN_DOMAIN:-example.com}"

usage() {
  cat <<'EOF'
usage: roots [sync] [--help]

roots — the routes accumulator: collects route configs from services in beds
and writes Traefik dynamic config. Traefik itself is a separate process in a
separate user.

commands:
  sync    regenerate Traefik dynamic config from every bed
EOF
}

cmd_sync() {
  mkdir -p "$DYNAMIC_DIR"
  python3 - "$BEDS_DIR" "$DYNAMIC_DIR" "$DOMAIN" <<'PYEOF'
import os, re, sys

beds_dir, dynamic_dir, domain = sys.argv[1], sys.argv[2], sys.argv[3]

ENVS = ("production", "staging", "preview", "fence")

def parse_bed_yaml(path):
    env = None
    routes = {}
    in_routes = False
    with open(path) as f:
        for line in f:
            raw = line.rstrip("\n")
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            indent = len(raw) - len(raw.lstrip())
            if indent == 0:
                in_routes = stripped == "routes:"
                if stripped.startswith("environment:"):
                    env = stripped.split(":", 1)[1].strip().strip("\"'")
                continue
            if in_routes and indent == 2 and not stripped.startswith("-"):
                m = re.match(r'(\S+):\s*"([^"]*)"', stripped)
                if m:
                    routes[m.group(1)] = m.group(2)
                    continue
                m = re.match(r"(\S+):\s*(\S+)", stripped)
                if m:
                    routes[m.group(1)] = m.group(2).strip("\"'")
    if env is not None and env not in ENVS:
        env = None
    return env, routes

def bed_id_env(bed_name):
    parts = bed_name.split("-")
    if len(parts) >= 3 and parts[0] == "bed" and parts[1] in ENVS:
        return parts[1]
    return None

def safe_name(name):
    return re.sub(r"[^A-Za-z0-9_.-]", "-", name)

def host_port(entry):
    entry = entry.split("/")[0].strip().strip("\"'")
    parts = entry.split(":")
    cand = parts[1] if len(parts) == 3 else parts[0]
    cand = cand.strip().strip("\"'")
    if cand.isdigit():
        return cand
    return None

def parse_compose_ports(path):
    ports = {}
    in_services = False
    current = None
    in_ports = False
    with open(path) as f:
        for line in f:
            raw = line.rstrip("\n")
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            indent = len(raw) - len(raw.lstrip())
            if indent == 0:
                in_services = stripped == "services:"
                current = None
                in_ports = False
                continue
            if not in_services:
                continue
            if indent == 2:
                in_ports = False
                if stripped.startswith("-"):
                    current = None
                elif stripped.endswith(":"):
                    current = stripped[:-1].strip()
                elif ":" in stripped:
                    current = stripped.split(":", 1)[0].strip()
                else:
                    current = None
                continue
            if current and indent == 4:
                if stripped.startswith("-"):
                    if in_ports:
                        p = host_port(stripped.lstrip("- ").strip())
                        if p:
                            ports.setdefault(current, p)
                    continue
                if stripped == "ports:":
                    in_ports = True
                    continue
                m = re.match(r"ports:\s*\[(.*)\]", stripped)
                if m:
                    for item in m.group(1).split(","):
                        item = item.strip().strip("\"'")
                        if not item:
                            continue
                        p = host_port(item)
                        if p:
                            ports.setdefault(current, p)
                    continue
                in_ports = False
                continue
            if current and in_ports and indent > 4 and stripped.startswith("-"):
                p = host_port(stripped.lstrip("- ").strip())
                if p:
                    ports.setdefault(current, p)
    return ports

def host_rule(pattern, env, ref):
    if pattern:
        rule = "Host(`%s`)" % pattern.replace("${env}", env).replace("${domain}", domain)
    elif env == "staging":
        rule = "Host(`staging.%s`)" % domain
    elif env == "production":
        rule = "Host(`%s`)" % domain
    elif env == "preview":
        rule = "Host(`preview.%s`)" % domain
    else:
        rule = "Host(`%s.%s`)" % (env, domain)
    if ref:
        rule += " && PathPrefix(`/%s`)" % ref
    return rule

def instance_refs(bed_dir):
    refs = []
    for name in sorted(os.listdir(bed_dir)):
        sub = os.path.join(bed_dir, name)
        if name == ".guarden" or not os.path.isdir(sub):
            continue
        if os.path.isfile(os.path.join(sub, "compose.yaml")) or os.path.isfile(os.path.join(sub, ".guarden", "bed.yaml")):
            refs.append(name)
    return refs

def add_unit(unit_dir, default_env, ref, prefix, routers, services):
    env = default_env
    routes = {}
    bed_yaml = os.path.join(unit_dir, ".guarden", "bed.yaml")
    if os.path.isfile(bed_yaml):
        yaml_env, yaml_routes = parse_bed_yaml(bed_yaml)
        if yaml_env:
            env = yaml_env
        routes = yaml_routes
    ports = {}
    compose = os.path.join(unit_dir, "compose.yaml")
    if os.path.isfile(compose):
        ports = parse_compose_ports(compose)
    if not ports:
        return
    if routes:
        for svc in sorted(routes):
            port = ports.get(svc)
            if not port:
                continue
            name = "%s-%s" % (prefix, svc)
            routers[name] = host_rule(routes[svc], env, ref)
            services[name] = port
    else:
        routers[prefix] = host_rule(None, env, ref)
        services[prefix] = ports[sorted(ports)[0]]

def config_text(routers, services):
    lines = ["http:", "  routers:"]
    for name in sorted(routers):
        lines.append("    %s:" % name)
        lines.append('      rule: "%s"' % routers[name])
        lines.append("      service: %s" % name)
    lines.append("  services:")
    for name in sorted(services):
        lines.append("    %s:" % name)
        lines.append("      loadBalancer:")
        lines.append("        servers:")
        lines.append('          - url: "http://127.0.0.1:%s"' % services[name])
    return "\n".join(lines) + "\n"

def write_if_changed(path, text):
    if os.path.isfile(path):
        with open(path) as f:
            if f.read() == text:
                return
    with open(path, "w") as f:
        f.write(text)

expected = set()
if os.path.isdir(beds_dir):
    for bed_name in sorted(os.listdir(beds_dir)):
        bed_dir = os.path.join(beds_dir, bed_name)
        if not os.path.isdir(bed_dir):
            continue
        yaml_env = None
        bed_yaml = os.path.join(bed_dir, ".guarden", "bed.yaml")
        if os.path.isfile(bed_yaml):
            yaml_env, _ = parse_bed_yaml(bed_yaml)
        env = yaml_env or bed_id_env(bed_name)
        if not env:
            continue
        routers = {}
        services = {}
        add_unit(bed_dir, env, None, bed_name, routers, services)
        if env == "preview":
            for ref in instance_refs(bed_dir):
                add_unit(os.path.join(bed_dir, ref), env, ref,
                         "%s-%s" % (bed_name, safe_name(ref)), routers, services)
        if not routers:
            continue
        out_path = os.path.join(dynamic_dir, "%s.yml" % bed_name)
        write_if_changed(out_path, config_text(routers, services))
        expected.add("%s.yml" % bed_name)

for fname in os.listdir(dynamic_dir):
    if fname.endswith(".yml") and fname not in expected:
        os.remove(os.path.join(dynamic_dir, fname))
PYEOF
  echo "roots: dynamic config written to $DYNAMIC_DIR"
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 0
    ;;
  sync)
    cmd_sync
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
